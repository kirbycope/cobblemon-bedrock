				"uv": {
					"texture_width": 45,
					"texture_height": 5,
					"flipbook": {
						"base_UV": [
							21,
							1
						],
						"size_UV": [
							3,
							3
						],
						"step_UV": [
							5,
							0
						],
						"frames_per_second": 12,
						"max_frame": 5
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.01,
				"expire_on_contact": true
