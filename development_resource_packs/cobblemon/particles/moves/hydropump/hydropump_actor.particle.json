{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:hydropump_actor",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/water/giantsplash"
			}
		},
		"curves": {
			"variable.sx": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0,
					0.55,
					0.9,
					1,
					1,
					1,
					1,
					1,
					1
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 300
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.75
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.45
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random_integer(0,3)*90"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"((-v.target_deltax+((v.particle_random_1-0.5)*0.5))*(v.particle_age/v.particle_lifetime))*1",
					"((v.target_deltay+((v.particle_random_2-0.5)*0.5))*(v.particle_age/v.particle_lifetime))*1.3",
					"-0.2+((-v.target_deltaz*(v.particle_age/v.particle_lifetime))*(1.2+(v.particle_random_3*0.2)))"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.55*v.sx",
					"0.55*v.sx"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 12,
					"texture_height": 96,
					"flipbook": {
						"base_UV": [
							0,
							"0+math.round(v.particle_random_4*2)*12"
						],
						"size_UV": [
							12,
							12
						],
						"step_UV": [
							0,
							12
						],
						"frames_per_second": 16,
						"max_frame": 2,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF5FB6FF",
						"1.0": "#ffffffff"
					}
				}
			}
		}
	}
}