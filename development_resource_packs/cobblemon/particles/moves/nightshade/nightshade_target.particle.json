{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:nightshade_target",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/vanilla/generic"
			}
		},
		"curves": {
			"variable.smokesize": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0.2,
					0.8,
					1,
					1,
					0.97,
					0.91,
					0.78,
					0.61,
					0.34,
					0
				]
			}
		},
		"events": {
			"hit": {
				"particle_effect": {
					"effect": "cobblemon:nightshade_targethit",
					"type": "emitter"
				}
			},
			"res": {
				"particle_effect": {
					"effect": "cobblemon:nightshade_targetres",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 600,
				"max_particles": 3000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "hit",
				"expiration_event": "res"
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"math.random(-0.45,0.45)/(v.emitter_age*2)",
					"math.random(-0.25,0.4)/(v.emitter_age*2)",
					"math.random(-0.45,0.45)/(v.emitter_age*2)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(v.particle_random_4*0.3)+0.5"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_4*3)*90"
			},
			"minecraft:particle_initial_speed": "math.random(3.25,8.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					1,
					0
				],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.225*v.smokesize)-(v.particle_random_3*0.07)",
					"(0.225*v.smokesize)-(v.particle_random_3*0.07)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 8,
					"flipbook": {
						"base_UV": [
							56,
							0
						],
						"size_UV": [
							8,
							8
						],
						"step_UV": [
							-8,
							0
						],
						"frames_per_second": 10,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 0.4,
				"collision_radius": 0.01
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_3*0.5 + (v.particle_age/v.particle_lifetime)",
					"gradient": {
						"0.0": "#FF001CAB",
						"1.25": "#FF12001D"
					}
				}
			}
		}
	}
}