{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:mysticalfire_actorshot",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/fire/cloudyfire_white"
			}
		},
		"curves": {
			"variable.burstarc": {
				"type": "linear",
				"input": "v.emitter_age",
				"horizontal_range": "v.emitter_lifetime",
				"nodes": [
					0.06,
					0.5,
					0.78,
					0.91,
					0.97,
					0.99,
					0.96,
					0.83,
					0.55,
					0.06
				]
			},
			"variable.fun": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					1,
					1,
					1,
					1,
					1,
					1,
					0.96,
					0.85,
					0.6,
					-0.05
				]
			}
		},
		"events": {
			"sparkle": {
				"particle_effect": {
					"effect": "cobblemon:mysticalfire_actormotilesparkle",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.9
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					"-v.target_deltax",
					"v.target_deltay*(v.emitter_age/v.emitter_lifetime)",
					"-0.5-v.target_deltaz*(v.emitter_age/v.emitter_lifetime)"
				],
				"radius": 0.3,
				"surface_only": true,
				"direction": [
					"math.random(-0.45,0.45)",
					"math.random(-0.15,0.35)",
					"math.random(-0.45,-0.25)*v.target_deltaz"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.45,0.75)"
			},
			"minecraft:particle_lifetime_events": {
				"creation_event": "sparkle"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_4*3)*90"
			},
			"minecraft:particle_initial_speed": "0.75*v.target_deltaz",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"(v.particle_random_1-0.5)*4",
					"3+(v.particle_random_1-0.5)*2",
					"(v.particle_random_1-0.5)*4"
				],
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.5*v.fun",
					"0.5*v.fun"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 160,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							16,
							16
						],
						"step_UV": [
							16,
							0
						],
						"frames_per_second": 20,
						"max_frame": 10
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.2": "#FFFFE872",
						"0.4": "#FFFFCC00",
						"0.55": "#FFFF9400",
						"0.75": "#FFFF4700",
						"0.9": "#FFFF4700",
						"1.0": "#FF531C0E"
					}
				}
			}
		}
	}
}