{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:watershuriken_actor",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/moves/watershuriken"
			}
		},
		"curves": {
			"variable.rsize": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0,
					1,
					1,
					1,
					1,
					1,
					1,
					1
				]
			}
		},
		"events": {
			"trail": {
				"particle_effect": {
					"effect": "cobblemon:watershuriken_actortrail",
					"type": "particle"
				}
			},
			"hit": {
				"particle_effect": {
					"effect": "cobblemon:watershuriken_target",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.25
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					"-((0)*(v.fx_fz ?? -1)+(0.1)*(v.fx_fx ?? 0))",
					0.02,
					"((0)*(v.fx_fx ?? 0)-(0.1)*(v.fx_fz ?? -1))"
				],
				"radius": 0.5,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.35
			},
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"0.00": "trail",
					"0.06": "trail",
					"0.12": "trail",
					"0.18": "trail",
					"0.24": "trail",
					"0.30": "trail",
					"0.34": "hit"
				}
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random_integer(0,3)*90"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"-((-(v.target_deltax ?? 0)*(v.particle_age / v.particle_lifetime))*(v.fx_fz ?? -1)+(-(v.target_deltaz ?? 5.0)*(v.particle_age / v.particle_lifetime))*(v.fx_fx ?? 0))",
					"((v.target_deltay ?? 0)*(v.particle_age / v.particle_lifetime))",
					"((-(v.target_deltax ?? 0)*(v.particle_age / v.particle_lifetime))*(v.fx_fx ?? 0)-(-(v.target_deltaz ?? 5.0)*(v.particle_age / v.particle_lifetime))*(v.fx_fz ?? -1))"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.4*v.rsize",
					"0.4*v.rsize"
				],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": [
						"-((0)*(v.fx_fz ?? -1)+(-1)*(v.fx_fx ?? 0))",
						0,
						"((0)*(v.fx_fx ?? 0)-(-1)*(v.fx_fz ?? -1))"
					]
				},
				"uv": {
					"texture_width": 60,
					"texture_height": 15,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							15,
							15
						],
						"step_UV": [
							15,
							0
						],
						"frames_per_second": 24,
						"max_frame": 4,
						"loop": true
					}
				}
			}
		}
	}
}