{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:stringshot_targetwrap",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/generic/wrap"
			}
		},
		"curves": {
			"variable.twirl": {
				"type": "linear",
				"input": "v.emitter_age",
				"horizontal_range": "v.emitter_lifetime",
				"nodes": [
					0,
					8
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 200
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.66
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					0,
					"math.sin(v.emitter_age*2133)*math.clamp(1,0.65,9)",
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.4
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.twirl)*90"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					"v.particle_random_2-0.5",
					0
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"1*math.clamp(1*1,0.5,9)",
					"1*math.clamp(1*1,0.5,9)"
				],
				"facing_camera_mode": "emitter_transform_xz",
				"uv": {
					"texture_width": 288,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							32,
							32
						],
						"step_UV": [
							32,
							0
						],
						"frames_per_second": 22,
						"max_frame": 9
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.85": "#FFCFD0C6",
						"1.0": "#008C907E"
					}
				}
			}
		}
	}
}