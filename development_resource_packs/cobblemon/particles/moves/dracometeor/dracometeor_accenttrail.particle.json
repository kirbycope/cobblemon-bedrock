{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:dracometeor_accenttrail",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/vanilla/generic"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"((v.particle_random_2*2)-1)/4",
					-1,
					"-(1.5+(((v.particle_random_4*2)-1)/2))"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_initial_speed": 10,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					0.2,
					0.2
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 8,
					"flipbook": {
						"base_UV": [
							56,
							0
						],
						"size_UV": [
							8,
							8
						],
						"step_UV": [
							-8,
							0
						],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "((v.particle_age / v.particle_lifetime)*0.8)+(v.particle_random_3*0.2)",
					"gradient": {
						"0.07": "#FFFFD06D",
						"0.5": "#FFED42A7",
						"1.0": "#FFBF0347"
					}
				}
			}
		}
