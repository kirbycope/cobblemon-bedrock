{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:supersonic_actor",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/generic/ring/mediumring"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 12,
				"max_particles": 17
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.7
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"v.target_deltax*(v.emitter_age/v.emitter_lifetime)",
					"v.target_deltay*(v.emitter_age/v.emitter_lifetime)",
					"-0.05-(v.target_deltaz*(v.emitter_age/v.emitter_lifetime))"
				],
				"direction": [
					0,
					"(v.target_deltay/v.target_distance)",
					-1
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.3
			},
			"minecraft:particle_initial_speed": "0.6*v.target_deltaz",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": "1*v.target_deltaz"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					0.5,
					0.5
				],
				"facing_camera_mode": "emitter_transform_xy",
				"uv": {
					"texture_width": 90,
					"texture_height": 15,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							15,
							15
						],
						"step_UV": [
							15,
							0
						],
						"frames_per_second": 20,
						"max_frame": 6
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFE3FEFF",
						"0.47": "#FF74BDFF",
						"1.0": "#FF3E38FF"
					}
				}
			}
		}
	}
}