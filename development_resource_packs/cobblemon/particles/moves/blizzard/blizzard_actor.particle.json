{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:blizzard_actor",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/impact/impact_ice"
			}
		},
		"curves": {
			"variable.bsizing": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0,
					0.69,
					0.96,
					1,
					1,
					1,
					1,
					1,
					1,
					0.96,
					0.82,
					0
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 900,
				"max_particles": 10000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.1
			},
			"minecraft:emitter_shape_box": {
				"offset": [
					0,
					4,
					2
				],
				"half_dimensions": [
					10,
					4,
					10
				],
				"direction": [
					"(v.particle_random_1-0.5)*0.5",
					"(v.target_deltay/v.target_distance)+((v.particle_random_2-0.5)*0.5)",
					-1
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.9,1.4)*1.1"
			},
			"minecraft:particle_initial_speed": "(v.particle_random_4+1)*16",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.sin(v.particle_age*((v.particle_random_2-0.5)*(360+(v.particle_random_2*180))))*1.5",
					"math.cos(v.particle_age*((v.particle_random_4-0.5)*(360+(v.particle_random_2*180))))*2",
					"math.sin(v.particle_age*((v.particle_random_1-0.5)*(360+(v.particle_random_2*180))))*1.5"
				],
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.1*v.bsizing",
					"0.1*v.bsizing"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 56,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							8,
							8
						],
						"step_UV": [
							0,
							8
						],
						"frames_per_second": 10,
						"max_frame": 7,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.2,
				"coefficient_of_restitution": 0.05,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"1.0": "#FFAAD4FF"
					}
				}
			}
		}
	}
}