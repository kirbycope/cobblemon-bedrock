{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:razorleaf_target",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/minihit"
			}
		},
		"events": {
			"leaf": {
				"particle_effect": {
					"effect": "cobblemon:razorleaf_targetexcess",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "25*math.clamp(1,0.75,1)",
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.4
			},
			"minecraft:emitter_shape_sphere": {
