{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:disarmingvoice_actorhearts",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/status/infatuation_heart"
			}
		},
		"curves": {
			"variable.d": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0,
					0.93,
					1,
					1,
					1,
					0.93,
					0.61,
					0
				]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.target_deltaz=5;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 25,
				"max_particles": 2000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.1
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"(v.target_deltax*(v.emitter_age/v.emitter_lifetime))+math.sin(v.emitter_age*360*7.5)*0.7",
					"(v.target_deltay*(v.emitter_age/v.emitter_lifetime))+math.cos(v.emitter_age*360*7.5)*0.7",
					"-(v.target_deltaz*(v.emitter_age/v.emitter_lifetime))"
				],
				"direction": [
					0,
					"(v.target_deltay/v.target_distance)",
					-1
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.45
			},
			"minecraft:particle_initial_speed": "v.target_deltaz*0.5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"(v.particle_random_1-0.5)",
					"(v.particle_random_2-0.5)",
					"(v.particle_random_3-0.5)"
				],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.1-(v.particle_random_4*0.04))*v.d",
					"(0.1-(v.particle_random_4*0.04))*v.d"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 90,
					"texture_height": 9,
					"uv": [
						3,
						3
					],
					"uv_size": [
						3,
						3
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF89E8",
						"1.0": "#FFE600BA"
					}
				}
			}
		}
