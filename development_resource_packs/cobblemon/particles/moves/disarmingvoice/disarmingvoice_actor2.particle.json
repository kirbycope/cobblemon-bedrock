			"minecraft:particle_appearance_billboard": {
				"size": [
					0.55,
					0.55
				],
				"facing_camera_mode": "emitter_transform_xy",
				"uv": {
					"texture_width": 90,
					"texture_height": 15,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							15,
							15
						],
						"step_UV": [
							15,
							0
						],
						"frames_per_second": 20,
						"max_frame": 6
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFECFE",
						"0.47": "#FFFF89E8",
						"1.0": "#FFE600BA"
					}
				}
			}
