{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:disarmingvoice_actor2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/generic/ring/mediumring"
			}
		},
		"components": {
