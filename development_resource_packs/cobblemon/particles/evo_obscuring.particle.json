				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 48,
					"flipbook": {
						"base_UV": [
							0,
							40
						],
						"size_UV": [
							8,
							8
						],
						"step_UV": [
							0,
							-8
						],
						"frames_per_second": 3,
						"max_frame": 6
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_4",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.22": "#FFCCFFFC",
						"0.56": "#FFDCE5FE",
						"0.77": "#FFFADDFE",
						"1.0": "#FF86FBFF"
					}
				}
			}
		}
