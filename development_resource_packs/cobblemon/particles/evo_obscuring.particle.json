				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 5
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random_integer(1,4) * 90"
			},
			"minecraft:particle_initial_speed": "math.clamp(1,0.5,2) * (1 >= 2 ? 5 : 10)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.random(-1,1) * 1",
					"math.random(-1,1) * 1",
					"math.random(-1,1) * 1"
				],
				"linear_drag_coefficient": "(1 >= 1.79 ? 18 : (1 <= 0.5 ? 8 : 10.5))"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.175 * math.clamp(1,1,2) * 1.5",
