{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.zubat.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        {
                            "air_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_hover": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_walking": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        {
                            "air_fly": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_fly": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_sleep": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_left": {
                    "animations": [
                        {
                            "shoulder_left": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_shoulder_left": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_right": {
                    "animations": [
                        {
                            "shoulder_right": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_shoulder_right": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.zubat.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        {
                            "primary_1": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}