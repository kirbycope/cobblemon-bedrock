{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.staraptor.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_flying": {
                    "animations": [
                        "air_battle_idle",
                        "pose_battle_flying"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        "air_idle",
                        "pose_hover"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        "air_fly",
                        {
                            "ride_air_fly": "q.has_rider"
                        },
                        "pose_fly"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "glide": {
                    "animations": [
                        "air_glide",
                        "ride_dive",
                        {
                            "ride_air_glide": "q.has_rider"
                        },
                        "pose_glide"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "battle_flying": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ]
                }
            }
        },
        "controller.animation.staraptor.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}