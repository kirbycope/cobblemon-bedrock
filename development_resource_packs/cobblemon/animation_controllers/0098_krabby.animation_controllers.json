{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.krabby.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "standing_bubbles": "v.pose == 1"
                        },
                        {
                            "standing_rain": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "battle_idle": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing_bubbles": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "standing_rain": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "battle_idle": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing_rain": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "standing_bubbles": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "battle_idle": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "standing_bubbles": "v.pose == 1"
                        },
                        {
                            "standing_rain": "v.pose == 2"
                        },
                        {
                            "battle_idle": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_idle": {
                    "animations": [
                        "battle_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "standing_bubbles": "v.pose == 1"
                        },
                        {
                            "standing_rain": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "standing_bubbles": "v.pose == 1"
                        },
                        {
                            "standing_rain": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "battle_idle": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.krabby.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.krabby.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}