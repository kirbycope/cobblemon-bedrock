{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.klinklang.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        {
                            "ride_mount_run": "q.has_rider"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        "battle_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        "ground_run"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walking": {
                    "animations": [
                        "mount_walk",
                        "ride_mount_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_running": {
                    "animations": [
                        "mount_run",
                        "ride_mount_run"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "mount_running": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.klinklang.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 2));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}