{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.maushold.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "maushold_four__ground_idle": "!v.primary"
                        },
                        {
                            "pose_standing": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "maushold_four__ground_walk": "!v.primary"
                        },
                        {
                            "pose_walking": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "sleep": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "maushold_four__sleep": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_left": {
                    "animations": [
                        {
                            "maushold_four__shoulder_left": "!v.primary"
                        },
                        {
                            "pose_shoulder_left": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_right": {
                    "animations": [
                        {
                            "maushold_four__shoulder_right": "!v.primary"
                        },
                        {
                            "pose_shoulder_right": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.maushold.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}