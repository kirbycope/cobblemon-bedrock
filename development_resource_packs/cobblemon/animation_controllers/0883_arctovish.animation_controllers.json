{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.arctovish.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "water_sleep": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "water_sleep": {
                    "animations": [
                        "water_sleep"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "water_sleep": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "water_sleep": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        "water_idle"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "water_sleep": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        "water_swim"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "water_sleep": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "water_sleep": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.arctovish.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (q.is_in_water)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.arctovish.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}