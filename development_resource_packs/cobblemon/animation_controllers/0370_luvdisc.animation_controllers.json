{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.luvdisc.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        {
                            "water_idle": "!v.primary"
                        },
                        {
                            "pose_float": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        {
                            "water_swim": "!v.primary"
                        },
                        {
                            "pose_swim": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "ground_sleep": {
                    "animations": [
                        {
                            "ground_sleep": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "water_sleep": {
                    "animations": [
                        {
                            "water_sleep": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.luvdisc.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.luvdisc.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "transitions": [
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}