{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.luvdisc.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        "water_idle",
                        "pose_float"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        "water_swim",
                        "pose_swim"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "ground_sleep": {
                    "animations": [
                        "ground_sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "water_sleep": {
                    "animations": [
                        "water_sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.luvdisc.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}