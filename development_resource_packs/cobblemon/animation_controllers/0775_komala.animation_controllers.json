{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.komala.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        }
                    ]
                }
            }
        },
        "controller.animation.komala.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}