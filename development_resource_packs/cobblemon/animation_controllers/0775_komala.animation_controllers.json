{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.komala.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        }
                    ]
                }
            }
        },
        "controller.animation.komala.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}