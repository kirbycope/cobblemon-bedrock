{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gorebyss.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "floating": "v.pose == 1"
                        },
                        {
                            "swimming": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "floating": {
                    "animations": [
                        "water_idle",
                        "pose_floating"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "swimming": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        "water_idle",
                        "pose_swimming"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "floating": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "floating": "v.pose == 1"
                        },
                        {
                            "swimming": "v.pose == 2"
                        }
                    ]
                }
            }
        }
    }
}