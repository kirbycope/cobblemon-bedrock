{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.yanmega.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "hovering": "v.pose == 2"
                        },
                        {
                            "flying": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "air_idle",
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hovering": "v.pose == 2"
                        },
                        {
                            "flying": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hovering": {
                    "animations": [
                        "air_idle",
                        "pose_hovering"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "flying": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "flying": {
                    "animations": [
                        "air_idle",
                        "pose_flying"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "hovering": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "hovering": "v.pose == 2"
                        },
                        {
                            "flying": "v.pose == 3"
                        }
                    ]
                }
            }
        }
    }
}