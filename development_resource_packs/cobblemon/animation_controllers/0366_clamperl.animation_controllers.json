{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.clamperl.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_walk": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "floating": {
                    "animations": [
                        {
                            "water_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_floating": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "swimming": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        {
                            "water_swim": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "water_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_swimming": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        }
                    ]
                }
            }
        }
    }
}