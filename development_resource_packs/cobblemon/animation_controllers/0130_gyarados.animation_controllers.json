{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gyarados.pose": {
            "initial_state": "spawn",
            "states": {
                "float": {
                    "animations": [
                        "water_idle"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "swim": "q.is_in_water && q.modified_move_speed > 0.1"
                        },
                        {
                            "idle": "!q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "moving": "!q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "swim": {
                    "animations": [
                        "water_swim"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "float": "q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "idle": "!q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "moving": "!q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "float": "q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "swim": "q.is_in_water && q.modified_move_speed > 0.1"
                        },
                        {
                            "moving": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "moving": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "float": "q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "swim": "q.is_in_water && q.modified_move_speed > 0.1"
                        },
                        {
                            "idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sleeping": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "idle": "!q.is_sleeping"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_move": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        },
                        {
                            "ride_fly": "!q.is_on_ground && !q.is_in_water"
                        },
                        {
                            "ride_swim": "q.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_move": {
                    "animations": [
                        "ride_ground_walk"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        },
                        {
                            "ride_fly": "!q.is_on_ground && !q.is_in_water"
                        },
                        {
                            "ride_swim": "q.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_fly": {
                    "animations": [
                        "ride_air_fly"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_idle": "q.is_on_ground && q.modified_move_speed <= 0.1"
                        },
                        {
                            "ride_move": "q.is_on_ground && q.modified_move_speed > 0.1"
                        },
                        {
                            "ride_swim": "q.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_swim": {
                    "animations": [
                        "ride_water_swim"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_idle": "!q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "ride_move": "!q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "spawn": {
                    "transitions": [
                        {
                            "idle": "1"
                        }
                    ]
                }
            }
        },
        "controller.animation.gyarados.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        },
                        {
                            "quirk_2": "v.quirk == 2"
                        },
                        {
                            "quirk_3": "v.quirk == 3"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 4));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.gyarados.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}