{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.magnezone.pose": {
            "initial_state": "spawn",
            "states": {
                "hover": {
                    "animations": [
                        {
                            "air_idle": "!v.primary"
                        },
                        {
                            "ride_air_fly": "(q.has_rider) && !v.primary"
                        },
                        {
                            "pose_hover": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "fly": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        {
                            "air_fly": "!v.primary"
                        },
                        {
                            "ride_air_fly": "(q.has_rider) && !v.primary"
                        },
                        {
                            "pose_fly": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "sleep": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "fly": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "fly": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        }
                    ]
                }
            }
        },
        "controller.animation.magnezone.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.magnezone.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "transitions": [
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}