        "controller.animation.wailord.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.wailord.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        }
                    ]
                }
            }
        }
