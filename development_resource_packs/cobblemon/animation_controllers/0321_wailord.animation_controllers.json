                        {
                            "surface_float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "surface_swim": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
