{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.milotic.pose": {
            "initial_state": "spawn",
            "states": {
                "jump": {
                    "animations": [
                        "water_swim",
                        {
                            "ride_water_swim": "q.has_rider"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.15
                },
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        "water_idle",
                        {
                            "ride_water_swim": "q.has_rider"
                        },
                        "pose_float"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        "water_swim",
                        {
                            "ride_water_swim": "q.has_rider"
                        },
                        "pose_swim"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep_male"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "float": "v.pose == 4"
                        },
                        {
                            "swim": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.milotic.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}