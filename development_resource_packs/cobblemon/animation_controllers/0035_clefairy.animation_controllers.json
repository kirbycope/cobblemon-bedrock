{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.clefairy.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_walk": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "sleep": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 2"
                        }
                    ]
                }
            }
        },
        "controller.animation.clefairy.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.clefairy.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        {
                            "primary_1": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        {
                            "primary_2": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}