{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.nickit.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        {
                            "item_hold": "q.property('cobblemon:holding')"
                        },
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        {
                            "item_hold": "q.property('cobblemon:holding')"
                        },
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        {
                            "item_hold": "q.property('cobblemon:holding')"
                        },
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep",
                        {
                            "item_hold": "q.property('cobblemon:holding')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        }
                    ]
                }
            }
        },
        "controller.animation.nickit.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        },
                        {
                            "quirk_2": "v.quirk == 2"
                        },
                        {
                            "quirk_3": "v.quirk == 3"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 4));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.nickit.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}