{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.bastiodon.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        {
                            "hold_item": "q.property('cobblemon:holding')"
                        },
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "ride_jump": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        {
                            "ride_ground_walk": "1 && q.has_rider"
                        },
                        {
                            "hold_item": "q.property('cobblemon:holding')"
                        },
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "ride_jump": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "ride_jump": {
                    "animations": [
                        "ride_jump",
                        {
                            "hold_item": "q.property('cobblemon:holding')"
                        },
                        "pose_ride_jump"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "walk": {
                    "animations": [
                        "ground_walk",
                        {
                            "ride_ground_walk": "1 && q.has_rider"
                        },
                        {
                            "hold_item": "q.property('cobblemon:holding')"
                        },
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "ride_jump": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "run": {
                    "animations": [
                        "ground_run",
                        {
                            "ride_ground_walk": "1 && q.has_rider"
                        },
                        {
                            "hold_item": "q.property('cobblemon:holding')"
                        },
                        "pose_run"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "ride_jump": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "sleep": {
                    "animations": [
                        "sleep",
                        {
                            "hold_item": "q.property('cobblemon:holding')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "ride_jump": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "ride_jump": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.bastiodon.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}