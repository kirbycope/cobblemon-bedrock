{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.shedinja.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        "air_idle"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        "air_fly"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        }
    }
}