{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.basculin.pose": {
            "initial_state": "spawn",
            "states": {
                "float": {
                    "animations": [
                        "water_idle"
                    ],
                    "transitions": [
                        {
                            "swim": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        "water_swim"
                    ],
                    "transitions": [
                        {
                            "float": "v.pose == 0"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "float": "v.pose == 0"
                        },
                        {
                            "swim": "v.pose == 1"
                        }
                    ]
                }
            }
        },
        "controller.animation.basculin.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}