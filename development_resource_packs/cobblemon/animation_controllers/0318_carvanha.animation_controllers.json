{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.carvanha.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "water_battle_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "floating": {
                    "animations": [
                        "water_idle"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "swimming": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        "water_swim"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "ground_sleep": {
                    "animations": [
                        "ground_sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "water_sleep": {
                    "animations": [
                        "water_sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 3"
                        },
                        {
                            "ground_sleep": "v.pose == 4"
                        },
                        {
                            "water_sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.carvanha.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.carvanha.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}