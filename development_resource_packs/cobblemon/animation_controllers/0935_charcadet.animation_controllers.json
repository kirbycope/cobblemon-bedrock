{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.charcadet.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        "sleep",
                        "eye_flame_overlay",
                        "head_flame_overlay"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "eye_flame_overlay",
                        "head_flame_overlay",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "eye_flame_overlay",
                        "head_flame_overlay",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulderleft": {
                    "animations": [
                        "shoulder_left",
                        "eye_flame_overlay",
                        "head_flame_overlay",
                        "pose_shoulderleft"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulderright": {
                    "animations": [
                        "shoulder_right",
                        "eye_flame_overlay",
                        "head_flame_overlay",
                        "pose_shoulderright"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.charcadet.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}