{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gastrodon.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        {
                            "gastrodon_east__battle_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_battle_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "jump": {
                    "animations": [
                        {
                            "gastrodon_east__ride_jump": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_jump": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "running": {
                    "animations": [
                        {
                            "gastrodon_east__ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "gastrodon_east__ride_ground_run": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_running": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "gastrodon_east__ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "gastrodon_east__ground_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "gastrodon_east__ride_ground_walk": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "gastrodon_east__sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.gastrodon.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}