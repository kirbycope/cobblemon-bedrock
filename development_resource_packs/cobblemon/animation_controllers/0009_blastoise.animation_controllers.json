        "controller.animation.blastoise.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (q.is_on_ground && !q.is_in_water)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.blastoise.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.blastoise.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "transitions": [
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
