{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.bounsweet.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "transitions": [
                        {
                            "walk": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        }
                    ]
                }
            }
        }
    }
}