{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.breloom.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battlestanding": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battlestanding": {
                    "animations": [
                        "battle_idle",
                        "pose_battlestanding"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battlestanding": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "ground_idle",
                        "ground_walk",
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battlestanding": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battlestanding": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        }
                    ]
                }
            }
        },
        "controller.animation.breloom.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}