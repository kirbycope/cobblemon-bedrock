{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.greninja.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle_alt": "v.clip_roll >= 0.0000 && v.clip_roll < 0.4000"
                        },
                        {
                            "ground_idle": "v.clip_roll >= 0.4000 && v.clip_roll < 1.0000"
                        },
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        "ground_run",
                        "pose_running"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "surface_swimming": {
                    "animations": [
                        "water_swim",
                        "pose_surface_swimming"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "surface_float": {
                    "animations": [
                        "water_idle",
                        "pose_surface_float"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        "water_swim",
                        "pose_swimming"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        "water_idle",
                        "pose_float"
                    ],
                    "transitions": [
