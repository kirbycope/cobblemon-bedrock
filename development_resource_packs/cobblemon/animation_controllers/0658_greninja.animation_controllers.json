                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "surface_float": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        },
                        {
                            "float": "v.pose == 7"
                        },
                        {
                            "sleep": "v.pose == 8"
                        }
                    ]
                }
            }
        },
        "controller.animation.greninja.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        },
                        {
                            "quirk_1": "v.quirk == 1 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 2));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.greninja.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}