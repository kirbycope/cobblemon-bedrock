{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gastly.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5,
                    "particle_effects": [
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        },
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        }
                    ]
                },
                "walking": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        }
                    ],
                    "blend_transition": 0.5,
                    "particle_effects": [
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        },
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        }
                    ]
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        }
                    ]
                }
            }
        },
        "controller.animation.gastly.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}