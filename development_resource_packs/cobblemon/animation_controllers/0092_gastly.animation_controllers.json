{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gastly.pose": {
            "initial_state": "spawn",
            "states": {
                "idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "moving": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        }
                    ],
                    "blend_transition": 0.2,
                    "particle_effects": [
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        },
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        }
                    ]
                },
                "moving": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        }
                    ],
                    "blend_transition": 0.2,
                    "particle_effects": [
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        },
                        {
                            "effect": "ghostly_smoke",
                            "locator": "gas"
                        }
                    ]
                },
                "spawn": {
                    "transitions": [
                        {
                            "idle": "1"
                        }
                    ]
                }
            }
        },
        "controller.animation.gastly.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}