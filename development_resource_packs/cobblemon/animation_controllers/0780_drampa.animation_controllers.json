{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.drampa.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "ground_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        {
                            "ride_ground_walk": "q.has_rider"
                        },
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hovering": {
                    "animations": [
                        "air_idle",
                        "pose_hovering"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "flying": {
                    "animations": [
                        "air_fly",
                        {
                            "ride_air_fly": "q.has_rider"
                        },
                        "pose_flying"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.drampa.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}