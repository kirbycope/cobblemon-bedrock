{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.drampa.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_battle_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_ground_walk": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_walking": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        {
                            "sleep": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hovering": {
                    "animations": [
                        {
                            "air_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_hovering": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "flying": {
                    "animations": [
                        {
                            "air_fly": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_air_fly": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_flying": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        },
                        {
                            "hovering": "v.pose == 4"
                        },
                        {
                            "flying": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.drampa.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}