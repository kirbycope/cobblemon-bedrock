{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.exploud.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        {
                            "idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 1"
                        }
                    ]
                }
            }
        }
    }
}