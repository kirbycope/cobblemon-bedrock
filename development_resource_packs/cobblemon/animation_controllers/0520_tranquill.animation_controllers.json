{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.tranquill.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        "sleep",
                        "pose_sleeping"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hovering": {
                    "animations": [
                        "air_idle",
                        "pose_hovering"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "flying": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "flying": {
                    "animations": [
                        "air_fly",
                        "pose_flying"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.tranquill.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}