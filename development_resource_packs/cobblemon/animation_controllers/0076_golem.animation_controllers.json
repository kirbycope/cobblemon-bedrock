{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.golem.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "wild_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "wild_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "wild_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "wild_sleep": {
                    "animations": [
                        {
                            "wild_sleep3": "v.clip_roll >= 0.0000 && v.clip_roll < 0.4000"
                        },
                        {
                            "wild_sleep2": "v.clip_roll >= 0.4000 && v.clip_roll < 0.7000"
                        },
                        {
                            "wild_sleep1": "v.clip_roll >= 0.7000 && v.clip_roll < 1.0000"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "wild_sleep": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.golem.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}