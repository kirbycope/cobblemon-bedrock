        "controller.animation.charizard.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        },
                        {
                            "quirk_1": "v.quirk == 1 && (q.is_on_ground && !q.is_in_water)"
                        },
                        {
                            "quirk_2": "v.quirk == 2 && (!q.is_on_ground && !q.is_in_water)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 3));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.charizard.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
