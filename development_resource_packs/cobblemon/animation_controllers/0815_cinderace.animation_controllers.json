{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.cinderace.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "!v.primary"
                        },
                        {
                            "pose_battle_standing": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!v.primary"
                        },
                        {
                            "pose_standing": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!v.primary"
                        },
                        {
                            "pose_walking": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        {
                            "sleep": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 3"
                        }
                    ]
                }
            }
        },
        "controller.animation.cinderace.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.cinderace.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "v.primary && q.property('cobblemon:primary') == 5"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "v.primary && q.property('cobblemon:primary') == 5"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        "primary_2"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "v.primary && q.property('cobblemon:primary') == 5"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_3": {
                    "animations": [
                        "primary_3"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "v.primary && q.property('cobblemon:primary') == 5"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_4": {
                    "animations": [
                        "primary_4"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_5": "v.primary && q.property('cobblemon:primary') == 5"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_5": {
                    "animations": [
                        "primary_5"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}