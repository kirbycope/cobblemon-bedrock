{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.rhyperior.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_battle_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "jump": {
                    "animations": [
                        {
                            "ride_jump": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_ground_run": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_jump": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "running": {
                    "animations": [
                        {
                            "ground_run": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_ground_run": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_running": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_ground_walk": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_walking": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.rhyperior.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.rhyperior.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        {
                            "primary_1": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        {
                            "primary_2": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_3": {
                    "animations": [
                        {
                            "primary_3": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_4": {
                    "animations": [
                        {
                            "primary_4": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}