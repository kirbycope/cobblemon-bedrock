{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.mimejr.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "mime_jr__ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "mime_jr__ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_walking": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        {
                            "mime_jr__ground_run": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_running": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_left": {
                    "animations": [
                        {
                            "mime_jr__shoulder_left": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_shoulder_left": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_right": {
                    "animations": [
                        {
                            "mime_jr__shoulder_right": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_shoulder_right": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 2"
                        },
                        {
                            "shoulder_left": "v.pose == 3"
                        },
                        {
                            "shoulder_right": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.mimejr.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}