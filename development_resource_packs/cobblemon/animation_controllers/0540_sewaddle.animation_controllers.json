{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.sewaddle.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "wild_sleep": {
                    "animations": [
                        "wild_sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_sleep": {
                    "animations": [
                        "battle_sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_left": {
                    "animations": [
                        "shoulder_left",
                        "pose_shoulder_left"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_right": {
                    "animations": [
                        "shoulder_right",
                        "pose_shoulder_right"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "wild_sleep": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.sewaddle.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 2));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.sewaddle.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}