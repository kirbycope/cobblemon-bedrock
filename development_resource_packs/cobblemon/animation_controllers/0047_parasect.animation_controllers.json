{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.parasect.pose": {
            "initial_state": "spawn",
            "states": {
                "stand": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        "ride_jump",
                        "ride_ground_run"
                    ],
                    "transitions": [
                        {
                            "stand": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "walk": {
                    "animations": [
                        "ground_walk",
                        {
                            "ride_ground_run": "q.has_rider && 1"
                        }
                    ],
                    "transitions": [
                        {
                            "stand": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "run": {
                    "animations": [
                        "ground_run",
                        {
                            "ride_ground_run": "q.has_rider && 1"
                        }
                    ],
                    "transitions": [
                        {
                            "stand": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "stand": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "stand": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ]
                }
            }
        }
    }
}