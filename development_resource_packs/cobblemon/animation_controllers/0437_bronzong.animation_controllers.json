{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.bronzong.pose": {
            "initial_state": "spawn",
            "states": {
                "hover": {
                    "animations": [
                        {
                            "ground_idle": "!v.primary"
                        },
                        {
                            "ride_mount_run": "((q.has_rider)) && !v.primary"
                        },
                        {
                            "pose_hover": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_hover": {
                    "animations": [
                        {
                            "ground_idle": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        {
                            "ground_run": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walking": {
                    "animations": [
                        {
                            "mount_run": "!v.primary"
                        },
                        {
                            "ride_mount_run": "!v.primary"
                        },
                        {
                            "pose_mount_walking": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!v.primary"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.bronzong.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        "primary_2"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_3": {
                    "animations": [
                        "primary_3"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_4": "v.primary && q.property('cobblemon:primary') == 4"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_4": {
                    "animations": [
                        "primary_4"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "v.primary && q.property('cobblemon:primary') == 3"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}