{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.fearow.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        {
                            "air_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_hover": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "fly": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        {
                            "air_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_fly": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        }
                    ]
                }
            }
        }
    }
}