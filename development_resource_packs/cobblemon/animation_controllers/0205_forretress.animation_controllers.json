{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.forretress.pose": {
            "initial_state": "spawn",
            "states": {
                "hover": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_walk": "((q.has_rider)) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_hover": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_hover": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        {
                            "ground_run": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walking": {
                    "animations": [
                        {
                            "ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_mount_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.forretress.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.forretress.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        }
                    ]
                }
            }
        }
    }
}