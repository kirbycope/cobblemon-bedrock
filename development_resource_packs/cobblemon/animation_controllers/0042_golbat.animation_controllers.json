{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.golbat.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_battle_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing_air": {
                    "animations": [
                        {
                            "battle_idle_air": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_battle_standing_air": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        {
                            "air_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_hover": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        {
                            "air_fly": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_fly": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "battle_standing_air": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.golbat.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}