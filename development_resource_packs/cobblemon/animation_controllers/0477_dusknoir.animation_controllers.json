{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dusknoir.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle"
                    ],
                    "transitions": [
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_standing": {
                    "animations": [
                        "ground_idle",
                        "ride_ground_run"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walking": {
                    "animations": [
                        "ground_run",
                        "ride_ground_run"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "mount_standing": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ]
                }
            }
        },
        "controller.animation.dusknoir.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}