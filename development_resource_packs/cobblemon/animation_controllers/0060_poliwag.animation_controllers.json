{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.poliwag.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        "sleep_placeholder"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle_placeholder"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk_placeholder"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        "water_idle_placeholder"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        "water_swim_placeholder"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        }
                    ]
                }
            }
        }
    }
}