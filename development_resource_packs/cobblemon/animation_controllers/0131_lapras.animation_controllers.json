        "controller.animation.lapras.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        },
                        {
                            "quirk_2": "v.quirk == 2"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 3));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
