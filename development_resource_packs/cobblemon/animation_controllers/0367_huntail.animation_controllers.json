{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.huntail.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "floating": "v.pose == 1"
                        },
                        {
                            "swimming": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "floating": {
                    "animations": [
                        {
                            "water_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_floating": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "swimming": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        {
                            "water_swim": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_swimming": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "floating": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "floating": "v.pose == 1"
                        },
                        {
                            "swimming": "v.pose == 2"
                        }
                    ]
                }
            }
        },
        "controller.animation.huntail.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}