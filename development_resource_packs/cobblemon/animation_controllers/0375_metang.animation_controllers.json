{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.metang.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "stand": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "battle_idle": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "stand": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "battle_idle": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        "air_idle"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "stand": "v.pose == 1"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "battle_idle": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        "air_fly"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "stand": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "battle_idle": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "stand": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "battle_idle": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "battle_idle": {
                    "animations": [
                        "battle_idle"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "stand": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "stand": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "battle_idle": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.metang.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}