        "controller.animation.dragapult.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.dragapult.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        {
                            "primary_1": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "clip_2": "v.primary && q.property('cobblemon:primary') == 2"
                        },
                        {
                            "off": "!v.primary"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
