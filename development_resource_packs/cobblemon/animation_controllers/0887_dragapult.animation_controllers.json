{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dragapult.pose": {
            "initial_state": "spawn",
            "states": {
                "hover": {
                    "animations": [
                        "air_fly"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "fly": "q.modified_move_speed > 0.1"
                        },
                        {
                            "idle": "q.is_on_ground && q.modified_move_speed <= 0.1"
                        },
                        {
                            "moving": "q.is_on_ground && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "fly": {
                    "animations": [
                        "air_fly"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "hover": "q.modified_move_speed <= 0.1"
                        },
                        {
                            "idle": "q.is_on_ground && q.modified_move_speed <= 0.1"
                        },
                        {
                            "moving": "q.is_on_ground && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "moving": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        },
                        {
                            "hover": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "fly": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "moving": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        },
                        {
                            "hover": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "fly": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sleeping": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "ride_idle": "q.has_rider"
                        },
                        {
                            "idle": "!q.is_sleeping"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_move": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        },
                        {
                            "ride_fly": "!q.is_on_ground && !q.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_move": {
                    "animations": [
                        "ride_ground_run"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        },
                        {
                            "ride_fly": "!q.is_on_ground && !q.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "ride_fly": {
                    "animations": [
                        "ride_air_fly"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.has_rider"
                        },
                        {
                            "ride_idle": "q.is_on_ground && q.modified_move_speed <= 0.1"
                        },
                        {
                            "ride_move": "q.is_on_ground && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "spawn": {
                    "transitions": [
                        {
                            "idle": "1"
                        }
                    ]
                }
            }
        },
        "controller.animation.dragapult.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}