{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.noivern.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        {
                            "ride_jump": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        {
                            "ground_run2": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_running": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        {
                            "air_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_hover": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        {
                            "air_fly": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_air_fly": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_fly": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "glide": {
                    "animations": [
                        {
                            "air_glide": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_dive": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_air_glide": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_glide": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.noivern.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}