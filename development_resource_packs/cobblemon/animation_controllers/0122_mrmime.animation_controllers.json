{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.mrmime.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "mr_mime__battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "jump": {
                    "animations": [
                        "mr_mime__ride_jump",
                        "pose_jump"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.15
                },
                "standing": {
                    "animations": [
                        "mr_mime__ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_standing": {
                    "animations": [
                        "mr_mime__mount_idle",
                        "pose_mount_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "mr_mime__ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walking": {
                    "animations": [
                        "mr_mime__mount_run",
                        "mr_mime__ride_mount_run",
                        "pose_mount_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        "mr_mime__ground_run",
                        "pose_running"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "jump": "v.pose == 1"
                        },
                        {
                            "standing": "v.pose == 2"
                        },
                        {
                            "mount_standing": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "mount_walking": "v.pose == 5"
                        },
                        {
                            "running": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ]
                }
            }
        },
        "controller.animation.mrmime.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.mrmime.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}