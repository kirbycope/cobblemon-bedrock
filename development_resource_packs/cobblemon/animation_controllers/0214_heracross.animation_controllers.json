{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.heracross.pose": {
            "initial_state": "spawn",
            "states": {
                "jump": {
                    "animations": [
                        "ride_jump"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.15
                },
                "standing": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        {
                            "ride_ground_run": "q.has_rider"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        "ground_run",
                        {
                            "ride_ground_run": "q.has_rider"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        "air_idle"
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        "air_fly",
                        {
                            "ride_air_fly": "q.has_rider"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "glide": {
                    "animations": [
                        "air_fly",
                        "ride_dive",
                        {
                            "ride_air_fly": "q.has_rider"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 5"
                        },
                        {
                            "glide": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.heracross.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}