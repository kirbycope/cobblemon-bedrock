{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.treecko.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "head_scale",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "head_scale",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "ground_walk",
                        "head_scale",
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "run": {
                    "animations": [
                        "ground_run",
                        "head_scale",
                        "pose_run"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_sleep": {
                    "animations": [
                        "battle_sleep",
                        "head_scale"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep",
                        "head_scale"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_left": {
                    "animations": [
                        "shoulder_left",
                        "head_scale",
                        "pose_shoulder_left"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_right": {
                    "animations": [
                        "shoulder_right",
                        "head_scale",
                        "pose_shoulder_right"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "battle_sleep": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        },
                        {
                            "shoulder_left": "v.pose == 6"
                        },
                        {
                            "shoulder_right": "v.pose == 7"
                        }
                    ]
                }
            }
        },
        "controller.animation.treecko.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (q.is_on_ground && !q.is_in_water)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.treecko.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}