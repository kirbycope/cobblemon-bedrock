{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.lunatone.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sand_sleep": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sand_sleep": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "sand_sleep": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sand_sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep_alt": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sand_sleep": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sand_sleep": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.lunatone.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.lunatone.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.lunatone.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        "primary_2"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_3": {
                    "animations": [
                        "primary_3"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_4": {
                    "animations": [
                        "primary_4"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        }
                    ]
                }
            }
        }
    }
}