{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.cyclizar.pose": {
            "initial_state": "spawn",
            "states": {
                "ride_jump": {
                    "animations": [
                        "ride_jump",
                        "ride_ground_run",
                        "pose_ride_jump"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_idle": {
                    "animations": [
                        "mount_idle",
                        "pose_mount_idle"
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walk": {
                    "animations": [
                        "ride_mount_walk",
                        "mount_walk",
                        "pose_mount_walk"
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "mount_run": {
                    "animations": [
                        "ride_ground_run",
                        "ground_run",
                        "pose_mount_run"
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.cyclizar.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}