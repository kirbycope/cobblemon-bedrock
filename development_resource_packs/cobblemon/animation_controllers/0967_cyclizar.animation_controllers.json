{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.cyclizar.pose": {
            "initial_state": "spawn",
            "states": {
                "ride_jump": {
                    "animations": [
                        {
                            "ride_jump": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_ride_jump": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_idle": {
                    "animations": [
                        {
                            "mount_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_mount_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walk": {
                    "animations": [
                        {
                            "ride_mount_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "mount_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_mount_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "mount_run": {
                    "animations": [
                        {
                            "ride_ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_mount_run": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "ride_jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_idle": "v.pose == 3"
                        },
                        {
                            "mount_walk": "v.pose == 4"
                        },
                        {
                            "mount_run": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.cyclizar.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}