{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.espathra.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleeping": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        {
                            "ride_jump": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_in_air": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleeping": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.05
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_ground_walk": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_walking": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleeping": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        {
                            "ground_run": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "ride_ground_run": "(q.has_rider) * (1 - (v.primary_w ?? 0))"
                        },
                        {
                            "pose_running": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleeping": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        {
                            "sleep": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleeping": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.espathra.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.espathra.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "v.primary && q.property('cobblemon:primary') == 1"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        {
                            "primary_1": "v.primary_w"
                        }
                    ],
                    "transitions": [
                        {
                            "off": "!v.primary"
                        }
                    ]
                }
            }
        }
    }
}