{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.clawitzer.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "clawitzer_left__water_idle": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        }
                    ]
                }
            }
        }
    }
}