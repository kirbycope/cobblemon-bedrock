{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.golurk.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        "ride_jump",
                        "pose_in_air"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "walk": {
                    "animations": [
                        "ground_walk",
                        {
                            "ride_ground_run": "q.has_rider"
                        },
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "run": {
                    "animations": [
                        "ground_run",
                        {
                            "ride_ground_run": "q.has_rider"
                        },
                        "pose_run"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "hover": {
                    "animations": [
                        "air_idle",
                        {
                            "ride_air_idle": "q.has_rider"
                        },
                        "pose_hover"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "fly": {
                    "animations": [
                        "air_fly",
                        {
                            "ride_air_fly": "q.has_rider"
                        },
                        "pose_fly"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "hover": "v.pose == 5"
                        },
                        {
                            "fly": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
                    ]
                }
            }
        },
        "controller.animation.golurk.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 2));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}