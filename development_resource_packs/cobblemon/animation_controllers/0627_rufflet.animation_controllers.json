{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.rufflet.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        "air_idle",
                        "pose_hover"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        "air_fly",
                        "pose_fly"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.rufflet.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (q.is_on_ground && !q.is_in_water)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.rufflet.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}