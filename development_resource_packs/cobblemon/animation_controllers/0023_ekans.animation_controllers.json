{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.ekans.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "normal": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "normal": {
                    "animations": [
                        "ground_idle",
                        "pose_normal"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "normal": "v.pose == 1"
                        }
                    ]
                }
            }
        },
        "controller.animation.ekans.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}