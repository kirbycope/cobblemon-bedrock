{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dratini.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        },
                        {
                            "surface_swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        },
                        {
                            "surface_swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        },
                        {
                            "surface_swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "float": {
                    "animations": [
                        {
                            "water_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "swim": "v.pose == 4"
                        },
                        {
                            "surface_swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swim": {
                    "animations": [
                        {
                            "water_swim": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "surface_swim": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "surface_swim": {
                    "animations": [
                        {
                            "surfacewater_swim": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "float": "v.pose == 3"
                        },
                        {
                            "swim": "v.pose == 4"
                        },
                        {
                            "surface_swim": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.dratini.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}