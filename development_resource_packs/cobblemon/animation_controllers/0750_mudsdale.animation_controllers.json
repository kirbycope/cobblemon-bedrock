{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.mudsdale.pose": {
            "initial_state": "spawn",
            "states": {
                "in_air": {
                    "animations": [
                        "ride_jump",
                        "ride_ground_run",
                        "blink",
                        "pose_in_air"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "blink",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 0"
                        },
                        {
                            "run": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "run": {
                    "animations": [
                        "ground_run",
                        "blink",
                        {
                            "ride_ground_run": "q.has_rider && 1 && q.is_on_ground"
                        },
                        "pose_run"
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "walk": {
                    "animations": [
                        "ground_walk",
                        "blink",
                        {
                            "ride_ground_walk": "q.has_rider && 1 && q.is_on_ground"
                        },
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "in_air": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "in_air": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.mudsdale.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}