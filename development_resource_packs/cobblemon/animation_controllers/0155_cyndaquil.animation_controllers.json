{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.cyndaquil.pose": {
            "initial_state": "spawn",
            "states": {
                "idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "moving": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "moving": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sleeping": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.is_sleeping"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "spawn": {
                    "transitions": [
                        {
                            "idle": "1"
                        }
                    ]
                }
            }
        },
        "controller.animation.cyndaquil.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}