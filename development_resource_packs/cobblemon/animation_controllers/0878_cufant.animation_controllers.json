{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.cufant.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "battle_idle": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "battle_idle": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "battle_idle": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_idle": {
                    "animations": [
                        {
                            "battle_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "battle_idle": "v.pose == 3"
                        }
                    ]
                }
            }
        },
        "controller.animation.cufant.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.cufant.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        "primary_2"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_3": {
                    "animations": [
                        "primary_3"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                },
                "clip_4": {
                    "animations": [
                        "primary_4"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        }
                    ]
                }
            }
        }
    }
}