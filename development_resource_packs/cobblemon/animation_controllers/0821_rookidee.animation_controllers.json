{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.rookidee.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "closed_wangs": "!q.property('cobblemon:primary')"
                        },
                        {
                            "held_item": "(q.property('cobblemon:holding')) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "walking": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        },
                        {
                            "sleep": "v.pose == 7"
                        }
