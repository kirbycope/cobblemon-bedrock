{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dudunsparce.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "dudunsparce_two_segment__battle_idle"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "dudunsparce_two_segment__ground_idle",
                        {
                            "dudunsparce_two_segment__ride_ground_walk": "q.has_rider"
                        },
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        "dudunsparce_two_segment__ride_jump",
                        "pose_in_air"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "walking": {
                    "animations": [
                        "dudunsparce_two_segment__ground_walk",
                        {
                            "dudunsparce_two_segment__ride_ground_walk": "q.has_rider"
                        },
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "run": {
                    "animations": [
                        "dudunsparce_two_segment__ground_run",
                        {
                            "dudunsparce_two_segment__ride_ground_run": "q.has_rider"
                        },
                        "pose_run"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "dudunsparce_two_segment__sleep"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.dudunsparce.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.dudunsparce.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}