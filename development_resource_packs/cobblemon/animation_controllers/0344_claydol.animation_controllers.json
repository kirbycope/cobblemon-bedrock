{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.claydol.pose": {
            "initial_state": "spawn",
            "states": {
                "hover": {
                    "animations": [
                        "ground_idle",
                        {
                            "ride_mount_run": "(q.has_rider)"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_hover": {
                    "animations": [
                        "battle_idle"
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        "ground_run"
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "mount_walking": {
                    "animations": [
                        "mount_run",
                        "ride_mount_run"
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "hover": "v.pose == 0"
                        },
                        {
                            "battle_hover": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 3"
                        },
                        {
                            "mount_walking": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.claydol.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        "quirk_0"
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.claydol.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}