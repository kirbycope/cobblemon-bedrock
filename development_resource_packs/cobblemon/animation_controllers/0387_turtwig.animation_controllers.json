{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.turtwig.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        {
                            "sleep": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_standing": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        {
                            "ground_walk": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_walk": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulderleft": {
                    "animations": [
                        {
                            "shoulder_left": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_shoulderleft": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulderright": {
                    "animations": [
                        {
                            "shoulder_right": "1 - (v.primary_w ?? 0)"
                        },
                        {
                            "pose_shoulderright": "1 - (v.primary_w ?? 0)"
                        }
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "shoulderleft": "v.pose == 3"
                        },
                        {
                            "shoulderright": "v.pose == 4"
                        }
                    ]
                }
            }
        },
        "controller.animation.turtwig.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}