                            "shoulderleft": "v.pose == 5"
                        },
                        {
                            "shoulderright": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hovering": {
                    "animations": [
                        "air_idle",
                        "pose_hovering"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "flying": "v.pose == 4"
                        },
                        {
                            "shoulderleft": "v.pose == 5"
                        },
                        {
                            "shoulderright": "v.pose == 6"
                        }
