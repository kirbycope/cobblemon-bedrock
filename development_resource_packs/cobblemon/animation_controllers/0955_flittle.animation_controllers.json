                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "shoulderleft": "v.pose == 5"
                        },
                        {
                            "shoulderright": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulderleft": {
                    "animations": [
                        "ground_idle",
                        "pose_shoulderleft"
                    ],
                    "transitions": [
