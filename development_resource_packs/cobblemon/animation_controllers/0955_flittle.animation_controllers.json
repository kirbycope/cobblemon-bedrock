                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        },
                        {
                            "shoulderleft": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        },
                        {
                            "shoulderleft": "v.pose == 5"
                        },
                        {
                            "shoulderright": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.flittle.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}