                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
