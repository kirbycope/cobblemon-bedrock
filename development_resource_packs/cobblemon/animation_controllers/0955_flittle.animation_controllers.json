{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.flittle.pose": {
            "initial_state": "spawn",
            "states": {
                "sleep": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        },
                        {
                            "shoulderleft": "v.pose == 5"
                        },
                        {
                            "shoulderright": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "walk": "v.pose == 2"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        },
                        {
                            "shoulderleft": "v.pose == 5"
                        },
                        {
                            "shoulderright": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        "ground_walk",
                        "pose_walk"
                    ],
                    "transitions": [
                        {
                            "sleep": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "hovering": "v.pose == 3"
                        },
                        {
                            "flying": "v.pose == 4"
                        },
