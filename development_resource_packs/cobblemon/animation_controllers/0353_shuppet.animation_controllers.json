{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.shuppet.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        "ground_idle_placeholder",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "fly": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "hover": {
                    "animations": [
                        "ground_idle_placeholder",
                        "pose_hover"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "fly": "v.pose == 2"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "fly": {
                    "animations": [
                        "ground_idle_placeholder",
                        "pose_fly"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "hover": "v.pose == 1"
                        },
                        {
                            "fly": "v.pose == 2"
                        }
                    ]
                }
            }
        },
        "controller.animation.shuppet.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}