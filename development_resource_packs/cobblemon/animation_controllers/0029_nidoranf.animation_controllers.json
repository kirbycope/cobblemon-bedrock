{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.nidoranf.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_battle_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "run": {
                    "animations": [
                        {
                            "ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_run": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_left": {
                    "animations": [
                        {
                            "shoulder_left": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_shoulder_left": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "shoulder_right": {
                    "animations": [
                        {
                            "shoulder_right": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_shoulder_right": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "run": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "shoulder_left": "v.pose == 5"
                        },
                        {
                            "shoulder_right": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.nidoranf.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}