{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.sharpedo.pose": {
            "initial_state": "spawn",
            "states": {
                "jump": {
                    "animations": [
                        {
                            "water_swim": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_water_swim": "(q.has_rider) && !q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "floating": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.15
                },
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "floating": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "floating": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "surface_floating": {
                    "animations": [
                        {
                            "surfacewater_idle": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "floating": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "surface_swimming": {
                    "animations": [
                        {
                            "surfacewater_swim": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "floating": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "floating": {
                    "animations": [
                        {
                            "water_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_water_swim": "(q.has_rider) && !q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        {
                            "water_swim": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_water_swim": "(q.has_rider) && !q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "floating": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "jump": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "surface_floating": "v.pose == 3"
                        },
                        {
                            "surface_swimming": "v.pose == 4"
                        },
                        {
                            "floating": "v.pose == 5"
                        },
                        {
                            "swimming": "v.pose == 6"
                        }
                    ]
                }
            }
        },
        "controller.animation.sharpedo.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (q.is_in_water)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}