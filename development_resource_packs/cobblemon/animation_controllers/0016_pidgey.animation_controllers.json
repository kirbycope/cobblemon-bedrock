{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.pidgey.pose": {
            "initial_state": "spawn",
            "states": {
                "hover": {
                    "animations": [
                        "air_idle"
                    ],
                    "transitions": [
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "fly": "q.modified_move_speed > 0.1"
                        },
                        {
                            "idle": "q.is_on_ground && q.modified_move_speed <= 0.1"
                        },
                        {
                            "moving": "q.is_on_ground && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "fly": {
                    "animations": [
                        "air_fly"
                    ],
                    "transitions": [
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "hover": "q.modified_move_speed <= 0.1"
                        },
                        {
                            "idle": "q.is_on_ground && q.modified_move_speed <= 0.1"
                        },
                        {
                            "moving": "q.is_on_ground && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "idle": {
                    "animations": [
                        "ground_idle"
                    ],
                    "transitions": [
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "moving": "q.modified_move_speed > 0.1 && q.is_on_ground"
                        },
                        {
                            "hover": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "fly": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "moving": {
                    "animations": [
                        "ground_walk"
                    ],
                    "transitions": [
                        {
                            "sleeping": "q.is_sleeping"
                        },
                        {
                            "idle": "q.modified_move_speed <= 0.1 && q.is_on_ground"
                        },
                        {
                            "hover": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed <= 0.1"
                        },
                        {
                            "fly": "!q.is_on_ground && !q.is_in_water && q.modified_move_speed > 0.1"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sleeping": {
                    "animations": [
                        "sleep"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.is_sleeping"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "spawn": {
                    "transitions": [
                        {
                            "idle": "1"
                        }
                    ]
                }
            }
        },
        "controller.animation.pidgey.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0"
                        },
                        {
                            "quirk_1": "v.quirk == 1"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 2));"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.pidgey.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}