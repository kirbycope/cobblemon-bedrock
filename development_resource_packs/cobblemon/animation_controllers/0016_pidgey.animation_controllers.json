                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "v.pose == 1"
                        },
                        {
                            "hover": "v.pose == 2"
                        },
                        {
                            "fly": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 4"
                        },
                        {
                            "air_sleep": "v.pose == 5"
                        },
                        {
