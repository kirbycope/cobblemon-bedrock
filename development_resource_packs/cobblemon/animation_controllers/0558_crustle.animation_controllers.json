{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.crustle.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "running": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_battle_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "running": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        {
                            "ride_jump": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_in_air": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "running": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "walking": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_walk": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walking": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "running": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "running": {
                    "animations": [
                        {
                            "ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_run": "(q.has_rider) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_running": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "running": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walking": "v.pose == 3"
                        },
                        {
                            "running": "v.pose == 4"
                        },
                        {
                            "sleep": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.crustle.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 1));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.crustle.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}