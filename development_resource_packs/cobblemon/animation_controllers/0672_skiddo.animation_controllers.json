{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.skiddo.pose": {
            "initial_state": "spawn",
            "states": {
                "standing": {
                    "animations": [
                        {
                            "ground_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "battle_standing": {
                    "animations": [
                        {
                            "battle_idle": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_battle_standing": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "in_air": {
                    "animations": [
                        {
                            "ride_jump": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "pose_in_air": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "sleep": {
                    "animations": [
                        {
                            "sleep": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walk": {
                    "animations": [
                        {
                            "ground_walk": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_walk": "(q.has_rider && 1) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_walk": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "run": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "run": {
                    "animations": [
                        {
                            "ground_run": "!q.property('cobblemon:primary')"
                        },
                        {
                            "ride_ground_run": "(q.has_rider && 1) && !q.property('cobblemon:primary')"
                        },
                        {
                            "pose_run": "!q.property('cobblemon:primary')"
                        }
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "spawn": {
                    "transitions": [
                        {
                            "standing": "v.pose == 0"
                        },
                        {
                            "battle_standing": "v.pose == 1"
                        },
                        {
                            "in_air": "v.pose == 2"
                        },
                        {
                            "sleep": "v.pose == 3"
                        },
                        {
                            "walk": "v.pose == 4"
                        },
                        {
                            "run": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.skiddo.quirk": {
            "initial_state": "wait",
            "states": {
                "wait": {
                    "transitions": [
                        {
                            "play": "!q.is_sleeping && !q.property('cobblemon:battle') && q.modified_move_speed < 0.1 && math.random(0, 900) < 1"
                        }
                    ]
                },
                "play": {
                    "animations": [
                        {
                            "quirk_0": "v.quirk == 0 && (q.is_on_ground && !q.is_in_water)"
                        },
                        {
                            "quirk_1": "v.quirk == 1 && (1)"
                        }
                    ],
                    "on_entry": [
                        "v.quirk = math.floor(math.random(0, 2));",
                        "v.quirking = 1;"
                    ],
                    "on_exit": [
                        "v.quirking = 0;"
                    ],
                    "transitions": [
                        {
                            "wait": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.skiddo.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "!q.is_sleeping && !(v.quirking ?? 0) && math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished || q.is_sleeping"
                        }
                    ]
                }
            }
        },
        "controller.animation.skiddo.primary": {
            "initial_state": "off",
            "states": {
                "off": {
                    "transitions": [
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "q.property('cobblemon:primary') == 5"
                        }
                    ]
                },
                "clip_1": {
                    "animations": [
                        "primary_1"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "q.property('cobblemon:primary') == 5"
                        }
                    ]
                },
                "clip_2": {
                    "animations": [
                        "primary_2"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "q.property('cobblemon:primary') == 5"
                        }
                    ]
                },
                "clip_3": {
                    "animations": [
                        "primary_3"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        },
                        {
                            "clip_5": "q.property('cobblemon:primary') == 5"
                        }
                    ]
                },
                "clip_4": {
                    "animations": [
                        "primary_4"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_5": "q.property('cobblemon:primary') == 5"
                        }
                    ]
                },
                "clip_5": {
                    "animations": [
                        "primary_5"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "off": "q.property('cobblemon:primary') == 0"
                        },
                        {
                            "clip_1": "q.property('cobblemon:primary') == 1"
                        },
                        {
                            "clip_2": "q.property('cobblemon:primary') == 2"
                        },
                        {
                            "clip_3": "q.property('cobblemon:primary') == 3"
                        },
                        {
                            "clip_4": "q.property('cobblemon:primary') == 4"
                        }
                    ]
                }
            }
        }
    }
}