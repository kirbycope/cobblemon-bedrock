{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.empoleon.pose": {
            "initial_state": "spawn",
            "states": {
                "battle_standing": {
                    "animations": [
                        "battle_idle_old",
                        "pose_battle_standing"
                    ],
                    "transitions": [
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "floating": "v.pose == 3"
                        },
                        {
                            "swimming": "v.pose == 4"
                        },
                        {
                            "sleeping": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "standing": {
                    "animations": [
                        "ground_idle_old",
                        "pose_standing"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "floating": "v.pose == 3"
                        },
                        {
                            "swimming": "v.pose == 4"
                        },
                        {
                            "sleeping": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "walking": {
                    "animations": [
                        "ground_walk_old",
                        "pose_walking"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "floating": "v.pose == 3"
                        },
                        {
                            "swimming": "v.pose == 4"
                        },
                        {
                            "sleeping": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "floating": {
                    "animations": [
                        "water_idle_old",
                        "pose_floating"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "swimming": "v.pose == 4"
                        },
                        {
                            "sleeping": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "swimming": {
                    "animations": [
                        "water_swim_old",
                        "pose_swimming"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "floating": "v.pose == 3"
                        },
                        {
                            "sleeping": "v.pose == 5"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "sleeping": {
                    "animations": [
                        "sleep_old",
                        "pose_sleeping"
                    ],
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "floating": "v.pose == 3"
                        },
                        {
                            "swimming": "v.pose == 4"
                        }
                    ],
                    "blend_transition": 0.5
                },
                "spawn": {
                    "transitions": [
                        {
                            "battle_standing": "v.pose == 0"
                        },
                        {
                            "standing": "v.pose == 1"
                        },
                        {
                            "walking": "v.pose == 2"
                        },
                        {
                            "floating": "v.pose == 3"
                        },
                        {
                            "swimming": "v.pose == 4"
                        },
                        {
                            "sleeping": "v.pose == 5"
                        }
                    ]
                }
            }
        },
        "controller.animation.empoleon.blink": {
            "initial_state": "open",
            "states": {
                "open": {
                    "transitions": [
                        {
                            "blink": "math.random(0, 200) < 1"
                        }
                    ]
                },
                "blink": {
                    "animations": [
                        "blink"
                    ],
                    "transitions": [
                        {
                            "open": "q.all_animations_finished"
                        }
                    ]
                }
            }
        }
    }
}