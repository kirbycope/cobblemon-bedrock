                "ground_walk": "animation.linoone.ground_walk",
                "sleep": "animation.linoone.sleep",
                "faint": "animation.linoone.faint",
                "blink": "animation.linoone.blink",
                "cry": "animation.linoone.cry",
                "pose_animation": "animation.linoone.pose",
                "pose_standing": "animation.0264_linoone.pose_standing",
                "pose_walking": "animation.0264_linoone.pose_walking",
                "pose_battle_idle": "animation.0264_linoone.pose_battle_idle",
                "evolution": "animation.0264_linoone.evolution"
