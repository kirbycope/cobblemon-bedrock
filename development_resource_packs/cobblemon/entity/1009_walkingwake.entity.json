            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 2)) ? 0 : (((v.pose_type == 0 || v.pose_type == 3 || v.pose_type == 5) && (!q.is_in_water)) ? 1 : (((v.pose_type == 0 || v.pose_type == 3 || v.pose_type == 5) && (q.is_in_water)) ? 2 : (((v.pose_type == 1 || v.pose_type == 4 || v.pose_type == 6) && (!q.is_in_water)) ? 3 : (((v.pose_type == 1 || v.pose_type == 4 || v.pose_type == 6) && (q.is_in_water)) ? 4 : (0)))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    "blink_quirk",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.walkingwake.pose",
                "blink_quirk": "controller.animation.walkingwake.blink",
                "look_at_target": "animation.1009_walkingwake.look",
                "ground_idle": "animation.walkingwake.ground_idle",
                "ground_walk": "animation.walkingwake.ground_walk",
                "faint": "animation.walkingwake.faint",
                "sleep": "animation.walkingwake.sleep",
                "cry": "animation.walkingwake.cry",
                "blink": "animation.walkingwake.blink",
                "pose_standing": "animation.1009_walkingwake.pose_standing",
                "pose_waterstanding": "animation.1009_walkingwake.pose_waterstanding",
                "pose_walk": "animation.1009_walkingwake.pose_walk",
                "pose_waterwalk": "animation.1009_walkingwake.pose_waterwalk",
                "evolution": "animation.1009_walkingwake.evolution"
