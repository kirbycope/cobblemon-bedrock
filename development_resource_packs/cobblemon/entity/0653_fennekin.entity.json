                "happy": "animation.fennekin.happy",
                "blush": "animation.fennekin.blush",
                "recoil": "animation.fennekin.recoil",
                "pose_standing": "animation.0653_fennekin.pose_standing",
                "pose_walking": "animation.0653_fennekin.pose_walking",
                "evolution": "animation.0653_fennekin.evolution"
            },
            "render_controllers": [
