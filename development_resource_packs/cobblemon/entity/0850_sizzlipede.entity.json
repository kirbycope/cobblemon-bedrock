                    "v.pose = ((v.pose_type == 2)) ? 0 : (((v.pose_type == 0 || v.pose_type == 3 || v.pose_type == 5) && (!q.property('cobblemon:battle'))) ? 1 : (((v.pose_type == 0 || v.pose_type == 3 || v.pose_type == 5) && (q.property('cobblemon:battle'))) ? 2 : (((v.pose_type == 1 || v.pose_type == 4 || v.pose_type == 6)) ? 3 : (((v.pose_type == 7)) ? 4 : (((v.pose_type == 8)) ? 5 : (0))))));",
