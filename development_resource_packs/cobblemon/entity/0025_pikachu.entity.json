            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0)));",
                    "v.pose = ((v.pose_type == 0) && (q.property('cobblemon:battle') && !q.is_in_water)) ? 0 : (((v.pose_type == 0) && (!q.property('cobblemon:battle') && !q.is_in_water)) ? 1 : (((v.pose_type == 1) && (!q.is_in_water)) ? 2 : (((v.pose_type == 2)) ? 3 : (((v.pose_type == 0 || v.pose_type == 5) && (!q.property('cobblemon:battle') && q.is_in_water)) ? 4 : (((v.pose_type == 1 || v.pose_type == 6) && (q.is_in_water)) ? 5 : (0))))));"
                ],
                "animate": [
                    "pose",
                    "blink_quirk",
                    "quirk"
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
