                "g_walrein": "geometry.walrein"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0 || v.pose_type == 1 || v.pose_type == 5 || v.pose_type == 6)) ? 0 : (0);",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    "blink_quirk",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.walrein.pose",
                "blink_quirk": "controller.animation.walrein.blink",
                "look_at_target": "animation.0365_walrein.look",
                "ground_idle": "animation.walrein.ground_idle",
                "mouth_open": "animation.walrein.mouth_open",
                "blink": "animation.walrein.blink",
                "cry": "animation.walrein.cry",
                "pose_standing": "animation.0365_walrein.pose_standing",
                "evolution": "animation.0365_walrein.evolution"
            },
            "render_controllers": [
                "controller.render.walrein"
            ],
            "spawn_egg": {
                "texture": "0365_walrein_spawn_egg"
            },
            "sound_effects": {
                "pokemon.walrein.cry": "cobblemon.walrein.cry"
            },
            "particle_effects": {
                "evo": "cobblemon:evo_particles"
            }
        }
    }
