{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "cobblemon:p0186_politoed",
            "materials": {
                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha",
                "translucent": "entity_alphablend"
            },
            "textures": {
                "default": "textures/entity/0186_politoed/politoed",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0186_politoed/politoed",
                "v1": "textures/entity/0186_politoed/politoed_shiny"
            },
            "geometry": {
                "g_politoed": "geometry.politoed"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0)) ? 0 : (((v.pose_type == 1)) ? 1 : (((v.pose_type == 3 || v.pose_type == 5)) ? 2 : (((v.pose_type == 4 || v.pose_type == 6)) ? 3 : (0))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.politoed.pose",
                "look_at_target": "animation.0186_politoed.look",
                "ground_idle": "animation.politoed.ground_idle",
                "water_idle": "animation.politoed.water_idle",
                "water_swim": "animation.politoed.water_swim",
                "pose_standing": "animation.0186_politoed.pose_standing",
                "pose_walking": "animation.0186_politoed.pose_walking",
                "pose_float": "animation.0186_politoed.pose_float",
                "pose_swim": "animation.0186_politoed.pose_swim",
                "evolution": "animation.0186_politoed.evolution"
            },
            "render_controllers": [
                "controller.render.politoed"
            ],
            "spawn_egg": {
                "texture": "0186_politoed_spawn_egg"
            },
            "particle_effects": {
                "evo": "cobblemon:evo_particles"
            }
        }
    }
}