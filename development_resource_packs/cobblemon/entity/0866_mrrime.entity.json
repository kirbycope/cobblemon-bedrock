{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "cobblemon:p0866_mrrime",
            "materials": {
                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha_one_sided",
                "translucent": "entity_alphablend"
            },
            "textures": {
                "default": "textures/entity/0866_mrrime/mr_rime",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0866_mrrime/mr_rime",
                "v1": "textures/entity/0866_mrrime/mr_rime_shiny"
            },
            "geometry": {
                "g_mr_rime": "geometry.mr_rime"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0 || v.pose_type == 5) && (q.property('cobblemon:battle'))) ? 0 : (((v.pose_type == 1 || v.pose_type == 6)) ? 1 : (0));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.mrrime.pose",
                "look_at_target": "animation.0866_mrrime.look",
                "ground_idle": "animation.mr_rime.ground_idle",
                "ground_idle_angry": "animation.mr_rime.ground_idle_angry",
                "ground_idle_happy": "animation.mr_rime.ground_idle_happy",
                "blink_1": "animation.mr_rime.blink_1",
                "blink_2": "animation.mr_rime.blink_2",
                "mr_rime__ground_idle": "animation.mr_rime.ground_idle",
                "pose_walking": "animation.0866_mrrime.pose_walking",
                "evolution": "animation.0866_mrrime.evolution"
            },
            "render_controllers": [
                "controller.render.mrrime"
            ],
            "spawn_egg": {
                "texture": "0866_mrrime_spawn_egg"
            },
            "particle_effects": {
                "evo": "cobblemon:evo_particles"
            }
        }
    }
