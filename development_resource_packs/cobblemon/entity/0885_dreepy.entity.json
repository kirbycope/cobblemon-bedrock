                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (((0) && !q.is_on_ground && !q.is_in_water) ? (v.moving ? 4 : 3) : (v.moving ? 1 : 0)))));",
                    "v.pose = ((v.pose_type == 0 || v.pose_type == 3) && (q.property('cobblemon:battle'))) ? 0 : (((v.pose_type == 0 || v.pose_type == 3) && (!q.property('cobblemon:battle'))) ? 1 : (((v.pose_type == 1 || v.pose_type == 4)) ? 2 : (((v.pose_type == 2)) ? 3 : (((v.pose_type == 7)) ? 4 : (((v.pose_type == 8)) ? 5 : (0))))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;",
                    "v.primary_t = q.property('cobblemon:primary') == v.primary_last ? v.primary_t + q.delta_time : 0;",
                    "v.primary_last = q.property('cobblemon:primary');",
                    "v.primary = q.property('cobblemon:primary') > 0 && v.primary_t < (q.property('cobblemon:primary') == 1 ? 9999 : 0);"
                ],
