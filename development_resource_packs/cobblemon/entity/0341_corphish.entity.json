{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "cobblemon:p0341_corphish",
            "materials": {
                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha_one_sided",
                "translucent": "entity_alphablend"
            },
            "textures": {
                "default": "textures/entity/0341_corphish/corphish",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0341_corphish/corphish",
                "v1": "textures/entity/0341_corphish/corphish_shiny"
            },
            "geometry": {
                "g_corphish": "geometry.corphish"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0)) ? 0 : (((v.pose_type == 1)) ? 1 : (((v.pose_type == 5)) ? 2 : (((v.pose_type == 6)) ? 3 : (0))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    "blink_quirk",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.corphish.pose",
                "blink_quirk": "controller.animation.corphish.blink",
                "look_at_target": "animation.0341_corphish.look",
                "ground_idle_placeholder": "animation.corphish.ground_idle_placeholder",
                "ground_walk_placeholder": "animation.corphish.ground_walk_placeholder",
                "water_swim_placeholder": "animation.corphish.water_swim_placeholder",
                "blink": "animation.corphish.blink",
                "embarrassed": "animation.corphish.embarrassed",
                "happy": "animation.corphish.happy",
                "sleepy": "animation.corphish.sleepy",
                "angry": "animation.corphish.angry",
                "sad": "animation.corphish.sad",
                "test": "animation.corphish.walkspeed.test",
                "cry": "animation.corphish.cry",
                "evolution": "animation.0341_corphish.evolution"
            },
            "render_controllers": [
                "controller.render.corphish"
            ],
            "spawn_egg": {
                "texture": "0341_corphish_spawn_egg"
            },
            "sound_effects": {
                "pokemon.corphish.cry": "cobblemon.corphish.cry"
            },
            "particle_effects": {
                "evo": "cobblemon:evo_particles"
            }
        }
    }
