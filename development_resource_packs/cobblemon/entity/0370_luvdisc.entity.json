{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "cobblemon:p0370_luvdisc",
            "materials": {
                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha_one_sided",
                "translucent": "entity_alphablend"
            },
            "textures": {
                "default": "textures/entity/0370_luvdisc/luvdisc",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0370_luvdisc/luvdisc",
                "v1": "textures/entity/0370_luvdisc/luvdisc_shiny"
            },
            "geometry": {
                "g_luvdisc": "geometry.luvdisc"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);",
                    "v.primary_last = 0; v.primary_t = 0;"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (((0) && !q.is_on_ground && !q.is_in_water) ? (v.moving ? 4 : 3) : (v.moving ? 1 : 0)))));",
                    "v.pose = ((v.pose_type == 0) && (!q.is_in_water)) ? 0 : (((v.pose_type == 1) && (!q.is_in_water)) ? 1 : (((v.pose_type == 5) && (q.is_in_water)) ? 2 : (((v.pose_type == 6) && (q.is_in_water)) ? 3 : (((v.pose_type == 2) && (!q.is_in_water)) ? 4 : (((v.pose_type == 2) && (q.is_in_water)) ? 5 : (0))))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;",
                    "v.primary_t = q.property('cobblemon:primary') == v.primary_last ? v.primary_t + q.delta_time : 0;",
                    "v.primary_last = q.property('cobblemon:primary');",
                    "v.primary = q.property('cobblemon:primary') > 0 && v.primary_t < (q.property('cobblemon:primary') == 1 ? 9999 : 0);"
                ],
                "animate": [
                    "pose",
                    "blink_quirk",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    },
                    "primary_controller"
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.luvdisc.pose",
                "blink_quirk": "controller.animation.luvdisc.blink",
                "water_idle": "animation.luvdisc.water_idle",
                "water_swim": "animation.luvdisc.water_swim",
                "water_faint": "animation.luvdisc.water_faint",
                "ground_idle": "animation.luvdisc.ground_idle",
                "ground_walk": "animation.luvdisc.ground_walk",
                "ground_faint": "animation.luvdisc.ground_faint",
                "water_sleep": "animation.luvdisc.water_sleep",
                "ground_sleep": "animation.luvdisc.ground_sleep",
                "physical_attack": "animation.luvdisc.physical_attack",
                "blink": "animation.luvdisc.blink",
                "special_attack": "animation.luvdisc.special_attack",
                "pose_float": "animation.0370_luvdisc.pose_float",
                "pose_swim": "animation.0370_luvdisc.pose_swim",
                "evolution": "animation.0370_luvdisc.evolution",
                "primary_1": "animation.luvdisc.ground_faint",
                "primary_controller": "controller.animation.luvdisc.primary"
            },
            "render_controllers": [
                "controller.render.luvdisc"
            ],
            "spawn_egg": {
                "texture": "0370_luvdisc_spawn_egg"
            },
            "particle_effects": {
                "evo": "cobblemon:evo_particles"
            }
        }
    }
