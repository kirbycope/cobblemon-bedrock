{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "cobblemon:p0779_bruxish",
            "materials": {
                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha",
                "translucent": "entity_alphablend"
            },
            "textures": {
                "default": "textures/entity/0779_bruxish/bruxish",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0779_bruxish/bruxish",
                "v1": "textures/entity/0779_bruxish/bruxish_shiny"
            },
            "geometry": {
                "g_bruxish": "geometry.bruxish"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0 || v.pose_type == 1 || v.pose_type == 5 || v.pose_type == 6)) ? 0 : (0);",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    "blink_quirk",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.bruxish.pose",
                "blink_quirk": "controller.animation.bruxish.blink",
                "ground_idle": "animation.bruxish.ground_idle",
                "mouth_open": "animation.bruxish.mouth_open",
                "blink": "animation.bruxish.blink",
                "shock": "animation.bruxish.shock",
                "angry": "animation.bruxish.angry",
                "sad": "animation.bruxish.sad",
                "happy": "animation.bruxish.happy",
                "recoil": "animation.bruxish.recoil",
                "cry": "animation.bruxish.cry",
                "evolution": "animation.0779_bruxish.evolution"
            },
            "render_controllers": [
                "controller.render.bruxish"
            ],
            "spawn_egg": {
                "texture": "0779_bruxish_spawn_egg"
            },
            "sound_effects": {
                "pokemon.bruxish.cry": "cobblemon.bruxish.cry"
            },
            "particle_effects": {
                "evo": "cobblemon:evo_particles"
            }
        }
    }
}