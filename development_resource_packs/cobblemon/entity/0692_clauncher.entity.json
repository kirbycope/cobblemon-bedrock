                "pose_standing": "animation.0692_clauncher.pose_standing",
                "clauncher_left__water_idle": "animation.clauncher_left.water_idle",
                "evolution": "animation.0692_clauncher.evolution"
            },
            "render_controllers": [
                "controller.render.clauncher"
            ],
            "spawn_egg": {
                "texture": "0692_clauncher_spawn_egg"
            },
            "sound_effects": {
                "pokemon.clauncher.cry": "cobblemon.clauncher.cry"
