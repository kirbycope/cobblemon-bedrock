                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha_one_sided",
                "translucent": "entity_alphablend",
                "alpha_eyes": "entity_emissive_alpha"
            },
            "textures": {
                "default": "textures/entity/0868_milcery/milcery",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0868_milcery/milcery",
                "v1": "textures/entity/0868_milcery/milcery_shiny",
                "alpha_eyes": "textures/entity/0868_milcery/milcery_alpha"
            },
            "geometry": {
                "g_milcery": "geometry.milcery"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (((1) && !q.is_on_ground && !q.is_in_water) ? (v.moving ? 4 : 3) : (v.moving ? 1 : 0)))));",
                    "v.pose = ((v.pose_type == 0 || v.pose_type == 1 || v.pose_type == 3 || v.pose_type == 4 || v.pose_type == 5 || v.pose_type == 6)) ? 0 : (((v.pose_type == 7)) ? 1 : (((v.pose_type == 8)) ? 2 : (0)));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    {
                        "alpha_eyes": "q.property('cobblemon:alpha')"
                    },
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.milcery.pose",
                "look_at_target": "animation.0868_milcery.look",
                "ground_idle": "animation.milcery.ground_idle",
                "ground_walk": "animation.milcery.ground_walk",
                "sleep": "animation.milcery.sleep",
                "faint": "animation.milcery.faint",
                "pose_standing": "animation.0868_milcery.pose_standing",
                "pose_shoulderleft": "animation.0868_milcery.pose_shoulderleft",
                "pose_shoulderright": "animation.0868_milcery.pose_shoulderright",
                "alpha_eyes": "animation.cobblemon.alpha_eyes.0868_milcery",
                "evolution": "animation.0868_milcery.evolution"
            },
            "render_controllers": [
                "controller.render.milcery",
                {
                    "controller.render.milcery_alpha": "q.property('cobblemon:alpha')"
                }
            ],
            "spawn_egg": {
                "texture": "0868_milcery_spawn_egg"
            },
            "particle_effects": {
