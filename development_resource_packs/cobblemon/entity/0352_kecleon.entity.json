{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "cobblemon:p0352_kecleon",
            "materials": {
                "default": "entity_alphatest_one_sided",
                "emissive": "entity_emissive_alpha",
                "translucent": "entity_alphablend"
            },
            "textures": {
                "default": "textures/entity/0352_kecleon/kecleon",
                "blank": "textures/entity/blank",
                "v0": "textures/entity/0352_kecleon/kecleon",
                "v1": "textures/entity/0352_kecleon/kecleon_shiny"
            },
            "geometry": {
                "g_kecleon": "geometry.kecleon"
            },
            "scripts": {
                "initialize": [
                    "v.clip_roll = math.random(0, 1);"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0 || v.pose_type == 5)) ? 0 : (((v.pose_type == 1 || v.pose_type == 6) && (!q.property('cobblemon:battle'))) ? 1 : (((v.pose_type == 2)) ? 2 : (0)));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
                    "pose",
                    {
                        "evolution": "q.property('cobblemon:evolving')"
                    }
                ],
                "scale": "q.property('cobblemon:size') * q.property('cobblemon:intrinsic')"
            },
            "animations": {
                "pose": "controller.animation.kecleon.pose",
                "look_at_target": "animation.0352_kecleon.look",
                "ground_idle": "animation.kecleon.ground_idle",
                "ground_walk": "animation.kecleon.ground_walk",
                "sleep": "animation.kecleon.sleep",
                "pose_animation": "animation.kecleon.pose",
                "sleep_test": "animation.kecleon.sleep_test",
                "tongue_n_tail": "animation.kecleon.tongue_n_tail",
                "expressions": "animation.kecleon.expressions",
                "walk_speed": "animation.kecleon.walk_speed",
                "cry": "animation.kecleon.cry",
                "pose_standing": "animation.0352_kecleon.pose_standing",
                "pose_walking": "animation.0352_kecleon.pose_walking",
                "evolution": "animation.0352_kecleon.evolution"
            },
            "render_controllers": [
                "controller.render.kecleon"
            ],
            "spawn_egg": {
                "texture": "0352_kecleon_spawn_egg"
            },
            "sound_effects": {
                "pokemon.kecleon.cry": "cobblemon.kecleon.cry"
            },
            "particle_effects": {
