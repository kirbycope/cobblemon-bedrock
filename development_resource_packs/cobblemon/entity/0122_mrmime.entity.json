                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (v.moving ? 1 : 0))));",
                    "v.pose = ((v.pose_type == 0) && (q.property('cobblemon:battle'))) ? 0 : (((v.pose_type == 0 || v.pose_type == 1) && ((!q.is_on_ground))) ? 1 : (((v.pose_type == 0) && (!q.property('cobblemon:battle') && (q.is_on_ground && !q.has_rider))) ? 2 : (((v.pose_type == 0) && (!q.property('cobblemon:battle') && (q.is_on_ground && q.has_rider))) ? 3 : (((v.pose_type == 1 || v.pose_type == 6) && ((q.is_on_ground && !q.has_rider && !(q.has_rider && q.ground_speed > 7)))) ? 4 : (((v.pose_type == 1 || v.pose_type == 6) && ((q.is_on_ground && q.has_rider))) ? 5 : (((v.pose_type == 1 || v.pose_type == 6) && (!q.property('cobblemon:battle') && (q.is_on_ground && !q.has_rider && (q.has_rider && q.ground_speed > 7)))) ? 6 : (((v.pose_type == 2)) ? 7 : (0))))))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;"
                ],
                "animate": [
