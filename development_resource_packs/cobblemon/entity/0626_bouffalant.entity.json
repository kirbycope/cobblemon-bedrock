                "initialize": [
                    "v.clip_roll = math.random(0, 1);",
                    "v.primary_last = 0; v.primary_t = 0;"
                ],
                "pre_animation": [
                    "v.moving = (q.ground_speed > 0.5 || math.abs(q.vertical_speed) > 0.5); v.pose_type = q.property('cobblemon:shoulder') > 0 ? 6 + q.property('cobblemon:shoulder') : (q.is_riding ? 0 : (q.is_sleeping ? 2 : (q.property('cobblemon:submerged') ? (v.moving ? 6 : 5) : (((0) && !q.is_on_ground && !q.is_in_water) ? (v.moving ? 4 : 3) : (v.moving ? 1 : 0)))));",
                    "v.pose = ((v.pose_type == 0) && (q.property('cobblemon:battle'))) ? 0 : (((v.pose_type == 0 || v.pose_type == 5) && (!q.property('cobblemon:battle'))) ? 1 : (((v.pose_type == 1 || v.pose_type == 6) && ((!(q.has_rider && q.ground_speed > 7)))) ? 2 : (((v.pose_type == 1) && (((q.has_rider && q.ground_speed > 7)))) ? 3 : (((v.pose_type == 2)) ? 4 : (0)))));",
                    "v.evo_t = q.property('cobblemon:evolving') ? (v.evo_t ?? 0) + q.delta_time : 0;",
                    "v.evo_glow = (v.evo_t > 5.25 && v.evo_t < 10.33) ? math.clamp(math.min(v.evo_t - 5.25, 10.33 - v.evo_t) / 0.25, 0, 0.85) : 0;",
                    "v.primary_t = q.property('cobblemon:primary') == v.primary_last ? v.primary_t + q.delta_time : 0;",
                    "v.primary_last = q.property('cobblemon:primary');",
                    "v.primary_len = (q.property('cobblemon:primary') == 1 ? 3.0 : (q.property('cobblemon:primary') == 2 ? 9999 : (q.property('cobblemon:primary') == 3 ? 3.0 : (q.property('cobblemon:primary') == 4 ? 3.0 : 0)))); v.primary_fade = (q.property('cobblemon:primary') == 1 ? 0.3 : (q.property('cobblemon:primary') == 2 ? 0.3 : (q.property('cobblemon:primary') == 3 ? 0.3 : (q.property('cobblemon:primary') == 4 ? 0.3 : 0))));",
                    "v.primary = q.property('cobblemon:primary') > 0 && v.primary_t < v.primary_len;",
                    "v.primary_w = v.primary ? math.clamp(math.min(v.primary_t, v.primary_len - v.primary_t) / v.primary_fade, 0, 1) : 0;"
                ],
