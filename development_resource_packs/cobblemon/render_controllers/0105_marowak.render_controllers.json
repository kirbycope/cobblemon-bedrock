{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.marowak": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1",
                        "Texture.v2",
                        "Texture.v3"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_marowak",
                        "Geometry.g_marowak",
                        "Geometry.g_marowak_alolan",
                        "Geometry.g_marowak_alolan"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ]
        },
        "controller.render.marowak_glow": {
            "materials": [
                {
                    "*": "Material.translucent"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.glow": [
                        "Texture.blank",
                        "Texture.blank",
                        "Texture.glow_2_0",
                        "Texture.glow_3_0"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_marowak",
                        "Geometry.g_marowak",
                        "Geometry.g_marowak_alolan",
                        "Geometry.g_marowak_alolan"
                    ]
                }
            },
            "textures": [
                "Array.glow[query.variant * 1]"
            ],
            "geometry": "Array.geo[query.variant]"
        }
    }
}