{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.drizzile": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "b": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "a": "math.max(q.property('cobblemon:red'), v.evo_glow ?? 0)"
            },
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_drizzile",
                        "Geometry.g_drizzile"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ],
            "part_visibility": [
                {
                    "*": true
                },
                {
                    "bomb": "q.property('cobblemon:battle')"
                },
                {
                    "bomb_top": "q.property('cobblemon:battle')"
                },
                {
                    "tongue": "q.property('cobblemon:battle')"
                },
                {
                    "tongue2": "q.property('cobblemon:battle')"
                },
                {
                    "tongue3": "q.property('cobblemon:battle')"
                },
                {
                    "tongue4": "q.property('cobblemon:battle')"
                },
                {
                    "tongue5": "q.property('cobblemon:battle')"
                },
                {
                    "tongue6": "q.property('cobblemon:battle')"
                }
            ]
        }
    }
}