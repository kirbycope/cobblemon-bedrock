{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.meowstic": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1",
                        "Texture.v2",
                        "Texture.v3"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_meowstic_male",
                        "Geometry.g_meowstic_male",
                        "Geometry.g_meowstic_female",
                        "Geometry.g_meowstic_female"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ]
        },
        "controller.render.meowstic_emissive": {
            "materials": [
                {
                    "*": "Material.translucent"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.emissive": [
                        "Texture.emissive_0_0",
                        "Texture.emissive_1_0",
                        "Texture.emissive_2_0",
                        "Texture.emissive_3_0"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_meowstic_male",
                        "Geometry.g_meowstic_male",
                        "Geometry.g_meowstic_female",
                        "Geometry.g_meowstic_female"
                    ]
                }
            },
            "textures": [
                "Array.emissive[query.variant * 1]"
            ],
            "geometry": "Array.geo[query.variant]"
        }
    }
}