{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.gourgeist": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "b": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "a": "math.max(q.property('cobblemon:red'), v.evo_glow ?? 0)"
            },
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1",
                        "Texture.v2",
                        "Texture.v3",
                        "Texture.v4",
                        "Texture.v5",
                        "Texture.v6",
                        "Texture.v7"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ]
        },
        "controller.render.gourgeist_color": {
            "materials": [
                {
                    "*": "Material.emissive"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.color": [
                        "Texture.color_0_0",
                        "Texture.color_1_0",
                        "Texture.color_2_0",
                        "Texture.color_3_0",
                        "Texture.color_4_0",
                        "Texture.color_5_0",
                        "Texture.color_6_0",
                        "Texture.color_7_0"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist",
                        "Geometry.g_gourgeist"
                    ]
                }
            },
            "textures": [
                "Array.color[query.variant * 1]"
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "b": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "a": "math.max(q.property('cobblemon:red'), v.evo_glow ?? 0)"
            },
            "geometry": "Array.geo[query.variant]"
        }
    }
}