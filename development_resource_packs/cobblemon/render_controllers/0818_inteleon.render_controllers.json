{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.inteleon": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
