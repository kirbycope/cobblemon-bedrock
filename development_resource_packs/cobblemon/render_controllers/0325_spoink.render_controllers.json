{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.spoink": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1",
                        "Texture.v2",
                        "Texture.v3"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_spoink",
                        "Geometry.g_spoink",
                        "Geometry.g_spoink",
                        "Geometry.g_spoink"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ]
        },
        "controller.render.spoink_pearl": {
            "materials": [
                {
                    "*": "Material.translucent"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.pearl": [
                        "Texture.pearl_0_0",
                        "Texture.pearl_1_0",
                        "Texture.pearl_2_0",
                        "Texture.pearl_3_0"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_spoink",
                        "Geometry.g_spoink",
                        "Geometry.g_spoink",
                        "Geometry.g_spoink"
                    ]
                }
            },
            "textures": [
                "Array.pearl[query.variant * 1]"
            ],
            "geometry": "Array.geo[query.variant]"
        }
    }
}