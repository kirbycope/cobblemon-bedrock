{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.hatterene": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "b": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "a": "math.max(q.property('cobblemon:red'), v.evo_glow ?? 0)"
            },
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_hatterene",
                        "Geometry.g_hatterene"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ],
            "part_visibility": [
                {
                    "*": true
                },
                {
                    "hair_opened": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_left": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_left_bend": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_left_end": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_left_tip": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_right": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_right_bend": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_right_end": "q.property('cobblemon:battle')"
                },
                {
                    "head_hair_opened_right_tip": "q.property('cobblemon:battle')"
                }
            ]
        }
    }
}