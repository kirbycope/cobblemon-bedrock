        "controller.render.skeledirge_color": {
            "materials": [
                {
                    "*": "Material.translucent"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.color": [
                        "Texture.color_0_0",
                        "Texture.color_1_0"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_skeledirge",
                        "Geometry.g_skeledirge"
                    ]
                }
            },
            "textures": [
                "Array.color[query.variant * 1]"
