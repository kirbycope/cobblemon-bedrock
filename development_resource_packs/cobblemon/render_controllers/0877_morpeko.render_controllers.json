{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.morpeko": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "b": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "a": "math.max(q.property('cobblemon:red'), v.evo_glow ?? 0)"
            },
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1",
                        "Texture.v2",
                        "Texture.v3"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_morpeko",
                        "Geometry.g_morpeko",
                        "Geometry.g_morpeko_hangry",
                        "Geometry.g_morpeko_hangry"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ]
        },
        "controller.render.morpeko_alpha": {
            "materials": [
                {
                    "*": "Material.alpha_eyes"
                }
            ],
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Texture.alpha_eyes"
            ],
            "arrays": {
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_morpeko",
                        "Geometry.g_morpeko",
                        "Geometry.g_morpeko_hangry",
                        "Geometry.g_morpeko_hangry"
                    ]
                }
            }
        }
    }
}