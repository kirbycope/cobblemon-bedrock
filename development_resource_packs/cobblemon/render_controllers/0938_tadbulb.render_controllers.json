{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.tadbulb": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_tadbulb",
                        "Geometry.g_tadbulb"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
