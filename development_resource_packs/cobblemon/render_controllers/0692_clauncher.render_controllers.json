{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.clauncher": {
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "overlay_color": {
                "r": 1.0,
                "g": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "b": "q.property('cobblemon:red') > 0 ? 0.1 : 1.0",
                "a": "math.max(q.property('cobblemon:red'), v.evo_glow ?? 0)"
            },
            "arrays": {
                "textures": {
                    "Array.skin": [
                        "Texture.v0",
                        "Texture.v1",
                        "Texture.v2",
                        "Texture.v3",
                        "Texture.v4",
                        "Texture.v5"
                    ]
                },
                "geometries": {
                    "Array.geo": [
                        "Geometry.g_clauncher_left",
                        "Geometry.g_clauncher_left",
                        "Geometry.g_clauncher_left",
                        "Geometry.g_clauncher_left",
                        "Geometry.g_clauncher_right",
                        "Geometry.g_clauncher_right"
                    ]
                }
            },
            "geometry": "Array.geo[query.variant]",
            "textures": [
                "Array.skin[query.variant]"
            ]
        }
    }
}