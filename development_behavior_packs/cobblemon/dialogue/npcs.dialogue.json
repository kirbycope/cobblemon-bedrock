{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "cobblemon:npc_trainer",
                "npc_name": "Trainer",
                "text": "Hello, I'm friend!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_trainer.hurt",
                "npc_name": "Trainer",
                "text": "Do you think I'd talk to you after you attacked me!? Get out of here!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_trainer.chat",
                "npc_name": "Trainer",
                "text": "Hello, friend! I'm Trainer!",
                "buttons": [
                    {
                        "name": "Battle",
                        "commands": [
                            "/scriptevent cobblemon:scene trainer_battle"
                        ]
                    },
                    {
                        "name": "Cancel",
                        "commands": []
                    }
                ]
            },
            {
                "scene_tag": "cobblemon:npc_trainer.battle",
                "npc_name": "Trainer",
                "text": "Go! Show them what you've got!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi",
                "npc_name": "Professor Sacchi",
                "text": "Hello! You can call me Professor Sacchi, or just 'the professor' as many do!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi.no_healer",
                "npc_name": "Professor Sacchi",
                "text": "I would offer to heal your Pokémon, but I can't seem to find my healing machine...\nI'm sorry about that!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi.full_health",
                "npc_name": "Professor Sacchi",
                "text": "I would offer to heal your Pokémon for you, but your Pokémon are completely healthy!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi.no_charge",
                "npc_name": "Professor Sacchi",
                "text": "I'd like to heal your Pokémon but my machine is busy! Please come back later!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi.okbye",
                "npc_name": "Professor Sacchi",
                "text": "Alright, see you later!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi.healed",
                "npc_name": "Professor Sacchi",
                "text": "Your Pokémon appear to be in top shape!\nSee you next time!",
                "buttons": []
            },
            {
                "scene_tag": "cobblemon:npc_sacchi.has_charge",
                "npc_name": "Professor Sacchi",
                "text": "Would you like me to heal your Pokémon?",
                "buttons": [
                    {
                        "name": "Yes",
                        "commands": [
                            "/scriptevent cobblemon:scene sacchi_heal"
                        ]
                    },
                    {
                        "name": "No",
                        "commands": [
                            "/dialogue open @s @initiator cobblemon:npc_sacchi.okbye"
                        ]
                    }
                ]
            }
        ]
    }
}