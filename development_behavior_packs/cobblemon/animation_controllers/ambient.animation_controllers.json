{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.0092_gastly.ambient": {
            "initial_state": "b",
            "states": {
                "a": {
                    "on_entry": [
                        "/particle cobblemon:ghostly_smoke_ambient ~0.0 ~0.25 ~0.25"
                    ],
                    "transitions": [
                        {
                            "b": "math.mod(q.life_time, 1.0) >= 0.5"
                        }
                    ]
                },
                "b": {
                    "transitions": [
                        {
                            "a": "math.mod(q.life_time, 1.0) < 0.5"
                        }
                    ]
                }
            }
        },
        "controller.animation.0218_slugma.ambient": {
            "initial_state": "b",
            "states": {
                "a": {
                    "on_entry": [
                        "/particle cobblemon:slugma_lava_bubble_ambient ~0.0 ~0.13 ~0.0"
                    ],
                    "transitions": [
                        {
                            "b": "math.mod(q.life_time, 1.0) >= 0.5"
                        }
                    ]
                },
                "b": {
                    "transitions": [
                        {
                            "a": "math.mod(q.life_time, 1.0) < 0.5"
                        }
                    ]
                }
            }
        },
        "controller.animation.0219_magcargo.ambient": {
            "initial_state": "b",
            "states": {
                "a": {
                    "on_entry": [
                        "/particle cobblemon:magcargo_lava_bubble_ambient ~0.0 ~0.17 ~0.0"
                    ],
                    "transitions": [
                        {
                            "b": "math.mod(q.life_time, 1.0) >= 0.5"
                        }
                    ]
                },
                "b": {
                    "transitions": [
                        {
                            "a": "math.mod(q.life_time, 1.0) < 0.5"
                        }
                    ]
                }
            }
        },
        "controller.animation.0250_hooh.ambient_air": {
            "initial_state": "b",
            "states": {
                "a": {
                    "on_entry": [
                        "/particle cobblemon:hooh_tailtrail_ambient ~0.0 ~1.66 ~2.02"
                    ],
                    "transitions": [
                        {
                            "b": "math.mod(q.life_time, 1.0) >= 0.5"
                        }
                    ]
                },
                "b": {
                    "transitions": [
                        {
                            "a": "math.mod(q.life_time, 1.0) < 0.5 && (!q.is_on_ground)"
                        }
                    ]
                }
            }
        },
        "controller.animation.0448_lucario.ambient_battle": {
            "initial_state": "b",
            "states": {
                "a": {
                    "on_entry": [
                        "/particle cobblemon:lucario_aura_ambient ~-0.71 ~1.18 ~-0.03",
                        "/particle cobblemon:lucario_aura_ambient ~0.71 ~1.18 ~-0.03"
                    ],
                    "transitions": [
                        {
                            "b": "math.mod(q.life_time, 1.0) >= 0.5"
                        }
                    ]
                },
                "b": {
                    "transitions": [
                        {
                            "a": "math.mod(q.life_time, 1.0) < 0.5 && (q.property('cobblemon:battle'))"
                        }
                    ]
                }
            }
        }
    }
}