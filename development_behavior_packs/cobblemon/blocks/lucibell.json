{
  "format_version": "1.21.120",
  "minecraft:block": {
    "description": {
      "identifier": "cobblemon:lucibell",
      "menu_category": {
        "category": "nature"
      },
      "states": {
        "cobblemon:half": [
          "lower",
          "upper"
        ],
        "cobblemon:glowing": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.cross",
      "minecraft:material_instances": {
        "*": {
          "texture": "cobblemon_block_flowers_lucibell_bottom",
          "render_method": "alpha_test",
          "face_dimming": false,
          "ambient_occlusion": false
        }
      },
      "minecraft:loot": "loot_tables/blocks/lucibell_lower.json",
      "minecraft:collision_box": false,
      "minecraft:selection_box": {
        "origin": [
          -6,
          0,
          -6
        ],
        "size": [
          12,
          16,
          12
        ]
      },
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      "cobblemon:terrain_plant": {},
      "minecraft:tick": {
        "interval_range": [
          10,
          20
        ],
        "looping": true
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('cobblemon:half') == 'lower' && q.block_state('cobblemon:glowing') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cobblemon_block_flowers_lucibell_bottom",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:loot": "loot_tables/blocks/lucibell_lower.json"
        }
      },
      {
        "condition": "q.block_state('cobblemon:half') == 'lower' && q.block_state('cobblemon:glowing') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cobblemon_block_flowers_lucibell_bottom_glowing",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:loot": "loot_tables/blocks/lucibell_lower.json",
          "minecraft:light_emission": 8
        }
      },
      {
        "condition": "q.block_state('cobblemon:half') == 'upper' && q.block_state('cobblemon:glowing') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cobblemon_block_flowers_lucibell_top",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:loot": "loot_tables/empty.json"
        }
      },
      {
        "condition": "q.block_state('cobblemon:half') == 'upper' && q.block_state('cobblemon:glowing') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cobblemon_block_flowers_lucibell_top_glowing",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:loot": "loot_tables/empty.json",
          "minecraft:light_emission": 8
        }
      }
    ]
  }
}